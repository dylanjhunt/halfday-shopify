<style>
  {% if section.settings.bg_color != blank %}
    .Page_2_col_image_contact_form_main { background-color: {{ section.settings.bg_color }}; }
  {% endif %}

  @media (max-width: 749px){
    {% if section.settings.bg_color_mobile != blank %}
      .Page_2_col_image_contact_form_main { background-color: {{ section.settings.bg_color_mobile }}; }
    {% else %} 
      .Page_2_col_image_contact_form_main { background-color: {{ section.settings.bg_color }}; }  
    {% endif %}
  }
</style>

{% if section.settings.video != blank or section.settings.image != blank or section.settings.heading_text != blank or section.settings.information_text != blank or section.blocks.size > 0 %}
  <div class="Page_2_col_image_contact_form_main Page_2_col_image_contact_form_main_{{ section.id }}">
    <div class="Page_2_col_image_contact_form_sides">
      {% if section.settings.video != blank or section.settings.image != blank %}
        <div class="Page_2_col_image_contact_form_leftmain" style="background-color: {{ section.settings.img_video_bg_color }}">
          <div class="Page_2_col_image_contact_form_leftinner">
            {% if section.settings.video != blank %}
              <div class="Page_2_col_image_contact_form_video_image">
                {{ section.settings.video | video_tag: class:'Common_video_new', image_size: 'master', controls: false, autoplay: true, loop: true }}
              </div>
              {% else %}
              <div class="Page_2_col_image_contact_form_video_image">
                {%- liquid
                  assign image_loading = 'lazy'
                  assign image_priority = 'auto'
                  if section.index == 1
                    assign image_loading = 'eager'
                    assign image_priority = 'high'
                  endif
                -%}
                <picture>
                  {%- comment -%}This column is hidden on mobile. An inline source avoids downloading its desktop photo.{%- endcomment -%}
                  <source media="(max-width: 749px)" srcset="data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20width='1'%20height='1'/%3E" width="1" height="1">
                  {{ section.settings.image | image_url: width: 2000 | image_tag:
                    widths: '360, 540, 750, 1000, 1250, 1600, 2000',
                    width: section.settings.image.width,
                    height: section.settings.image.height,
                    sizes: '(min-width: 1440px) calc(50vw - 156px), (min-width: 990px) calc(50vw - 80px), calc(50vw - 60px)',
                    loading: image_loading,
                    fetchpriority: image_priority
                  }}
                </picture>
              </div>
            {% endif %}
          </div>
        </div>
      {% endif %}
      {% if section.settings.heading_text != blank or section.settings.information_text != blank or section.blocks.size > 0 %}
        <div class="Page_2_col_image_contact_form_rightmain">
          <div class="Page_2_col_image_contact_form_rightinner">
            {% if section.settings.heading_text != blank %}
              <div class="Page_2_col_image_contact_form_heading_text Common_title_new">
                <{{ section.settings.heading_tag | default: 'h2' }}>
                  {{ section.settings.heading_text }}
                </{{ section.settings.heading_tag | default: 'h2' }}>
              </div>
            {% endif %}
            {% if section.settings.information_text != blank %}
              <div class="Page_2_col_image_contact_form_information_text">
                {{ section.settings.information_text }}
              </div>
            {% endif %}
            {% if section.blocks.size > 0 %}
              <div class="Page_2_col_image_contact_form_container">
                {% for block in section.blocks %}
                  {% case block.type %}
                    {% when '@app' %}
                      {% render block %} 
                  {% endcase %}
                {% endfor %} 
              </div>
            {% endif %}
              <div class="Page_2_col_image_contact_form_container">
                {%- form 'contact', id: 'ContactForm', class: contact_form_class -%}
                  {%- if form.posted_successfully? -%}
                    <h2 class="form-status form-status-list form__message" tabindex="-1" autofocus>
                      {{- 'icon-success.svg' | inline_asset_content -}}
                      {{ 'templates.contact.form.post_success' | t }}
                    </h2>
                  {%- elsif form.errors -%}
                    <div class="form__message">
                      <h2 class="form-status caption-large text-body" role="alert" tabindex="-1" autofocus>
                        {{- 'icon-error.svg' | inline_asset_content -}}
                        {{ 'templates.contact.form.error_heading' | t }}
                      </h2>
                    </div>
                    <ul class="form-status-list caption-large" role="list">
                      <li>
                        <a href="#ContactForm-email" class="link">
                          {{ form.errors.translated_fields.email | capitalize }}
                          {{ form.errors.messages.email }}
                        </a>
                      </li>
                    </ul>
                  {%- endif -%}
                  <div class="contact__fields">
                    <div class="field">
                      <input
                        class="field__input"
                        autocomplete="name"
                        type="text"
                        id="ContactForm-name"
                        name="contact[{{ 'templates.contact.form.name' | t }}]"
                        value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"

                        {% comment %}
                        
                        placeholder="{{ 'templates.contact.form.name' | t }}"
                        {% endcomment %}
                        placeholder="Name"
                        
                      >
                      <label class="visually-hidden" for="ContactForm-name">{{ 'templates.contact.form.name' | t }}</label>
                    </div>
                    <div class="field field--with-error">
                      <input
                        autocomplete="email"
                        type="email"
                        id="ContactForm-email"
                        class="field__input"
                        name="contact[email]"
                        spellcheck="false"
                        autocapitalize="off"
                        value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                        aria-required="true"
                        {% if form.errors contains 'email' %}
                          aria-invalid="true"
                          aria-describedby="ContactForm-email-error"
                        {% endif %}
                        {% comment %}
                          
                         placeholder="{{ 'templates.contact.form.email' | t }}"
                        {% endcomment %}
                        placeholder="Email Address"
                      >
                      <label class="visually-hidden" for="ContactForm-email">
                        {{- 'templates.contact.form.email' | t }}
                        <span aria-hidden="true">*</span></label
                      >
                      {%- if form.errors contains 'email' -%}
                        <small class="contact__field-error" id="ContactForm-email-error">
                          <span class="visually-hidden">{{ 'accessibility.error' | t }}</span>
                          <span class="form__message">
                            <span class="svg-wrapper">
                              {{- 'icon-error.svg' | inline_asset_content -}}
                            </span>
                            {{- form.errors.translated_fields.email | capitalize }}
                            {{ form.errors.messages.email -}}
                          </span>
                        </small>
                      {%- endif -%}
                    </div>
                  </div>

                  {% comment %}
                    
                  <div class="field">
                    <input
                      type="tel"
                      id="ContactForm-phone"
                      class="field__input"
                      autocomplete="tel"
                      name="contact[{{ 'templates.contact.form.phone' | t }}]"
                      pattern="[0-9\-]*"
                      value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
                      placeholder="{{ 'templates.contact.form.phone' | t }}"
                    >
                    <label class="field__label" for="ContactForm-phone">{{ 'templates.contact.form.phone' | t }}</label>
                  </div>
                  {% endcomment %}
                
                  <div class="field">
                    <textarea
                      rows="10"
                      id="ContactForm-body"
                      class="text-area field__input"
                      name="contact[{{ 'templates.contact.form.comment' | t }}]"

                      {% comment %}
                      placeholder="{{ 'templates.contact.form.comment' | t }}"
                        
                      {% endcomment %}
                      
                      placeholder="Message"
                      
                    >
                      {{- form.body -}}
                    </textarea>
                    <label class="visually-hidden" for="ContactForm-body">
                      {{- 'templates.contact.form.comment' | t -}}
                    </label>
                  </div>
                  <div class="contact__button">
                    <button type="submit" class="button">
                      {% comment %}
                      {{ 'templates.contact.form.send' | t }}
                      {% endcomment %}
                  
                      Send Message
                    </button>
                  </div>
                {%- endform -%}
                </div>
          </div>
        </div>
      {% endif %}
    </div>
  </div>
{% endif %}

<style>
  .Page_2_col_image_contact_form_sides { display: flex; }
  .Page_2_col_image_contact_form_leftmain { width: 50%; padding: 80px 78px; }
  .Page_2_col_image_contact_form_rightmain { width: 50%; padding: 70px 56px; }
  .Page_2_col_image_contact_form_leftinner { height: 100%; }
  .Page_2_col_image_contact_form_video_image { height: 100%; }
  .Page_2_col_image_contact_form_video_image picture { display: block; width: 100%; height: 100%; }
  .Page_2_col_image_contact_form_video_image video, .Page_2_col_image_contact_form_video_image img { width: 100%; height: 100% !important; display: block; object-fit: cover; }
  .Page_2_col_image_contact_form_heading_text :is(h1, h2) { text-align: left; }
  .Page_2_col_image_contact_form_information_text { padding-top: 22px; }
  .Page_2_col_image_contact_form_container { padding-top: 28px; }
  .Page_2_col_image_contact_form_information_text p { margin: 0; color: #004600; font-size: 18px; font-weight: 600; line-height: 120%; letter-spacing: 0.36px; font-family: var(--font-museo-sans-family); }
  .Page_2_col_image_contact_form_information_text a { color: #004600; font-weight: 800; font-family: var(--font-museo-slab-family); }
  /* .Page_2_col_image_contact_form_information_text p strong { text-decoration: underline;  } */
  .Page_2_col_image_contact_form_information_text p:not(:first-child) { margin-top: 12px; }

  .Page_2_col_image_contact_form_container form .field:before, .Page_2_col_image_contact_form_container form .field:after { display: none; }
  .Page_2_col_image_contact_form_container form .field__input { height: 48px; padding: 12px 20px; border-radius: 99px; border: 2px solid #004600; margin-bottom: 8px; }
  .Page_2_col_image_contact_form_container form textarea { border-radius: 12px !important; height: 200px !important; }
  .Page_2_col_image_contact_form_container form .field__input::placeholder { opacity: 1; text-transform: uppercase; }
  .Page_2_col_image_contact_form_container form .field__input, .Page_2_col_image_contact_form_container form .field__input::placeholder { font-family: var(--font-museo-slab-family) !important; color: #004600; font-size: 16px; font-weight: 800; line-height: 135%; letter-spacing: 0.32px;}
  .Page_2_col_image_contact_form_container form .contact__button .button { width: 100%; }

  @media (min-width: 1441px){
    .Page_2_col_image_contact_form_rightinner { display: flex; flex-direction: column; justify-content: center; height: 100%; margin: 0 auto; max-width: 608px; width: 100%; }
  }
  
  @media (min-width: 990px) and (max-width: 1439px) {
    .Page_2_col_image_contact_form_rightmain { padding: 40px 30px; }
    .Page_2_col_image_contact_form_leftmain { padding: 40px; }
  }

  @media (max-width: 989px){
    .Page_2_col_image_contact_form_rightmain { padding: 30px 20px; }
    .Page_2_col_image_contact_form_leftmain { padding: 30px; }
    .Page_2_col_image_contact_form_information_text, .Page_2_col_image_contact_form_container { padding-top: 24px; }
  }

  @media (max-width: 749px){
    .Page_2_col_image_contact_form_leftmain { display: none; }
    .Page_2_col_image_contact_form_rightmain { width: 100%; }
    .Page_2_col_image_contact_form_heading_text :is(h1, h2), .Page_2_col_image_contact_form_information_text p,
    .Page_2_col_image_contact_form_information_text a { text-align: center; color: #FFF; }

    .Page_2_col_image_contact_form_container form .field__input { border: 2px solid #FFF; }
    .Page_2_col_image_contact_form_container form .contact__button .button { background-color: #FFE700; color: #004600; }
  }
  
</style>

{% schema %}
  {
    "name": "Page 2 Col Contact Form",
    "class": "Page_2_col_image_contact_form",
    "settings": [
      {
        "type": "select",
        "id": "heading_tag",
        "label": "Heading level",
        "options": [
          { "value": "h1", "label": "H1 (page title)" },
          { "value": "h2", "label": "H2 (section title)" }
        ],
        "default": "h2"
      },
      {
        "type": "color",
        "id": "bg_color",
        "label": "Add Main Background Color",
        "default": "#FFF"
      },
      {
        "type": "color",
        "id": "bg_color_mobile",
        "label": "Add Main Background Color - Mobile",
        "default": "#FF5528"
      },
      {
        "type": "video",
        "id": "video",
        "label": "Add Video"
      },
      {
        "type": "image_picker",
        "id": "image",
        "label": "Add Image"
      },
      {
        "type": "color",
        "id": "img_video_bg_color",
        "label": "Add Image Video Background Color",
        "default": "#FF5528"
      },
      {
        "type": "text",
        "id": "heading_text",
        "label": "Add Heading Text",
        "default": "Drop us a line"
      },
      {
        "type": "richtext",
        "id": "information_text",
        "label": "Add Information Text",
      }
    ],
    "blocks": [
      {
        "type": "@app"
      }
    ],
    "presets": [
      {
        "name": "Page 2 Col Image Contact Form"
      }
    ]
  }
{% endschema %}