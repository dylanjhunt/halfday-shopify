{%- if product.metafields.custom.index_testimonial_item_selection != blank -%}
  {%- assign index_testimonial_item_selection = product.metafields.custom.index_testimonial_item_selection.value -%}
  {%- if index_testimonial_item_selection.main_home_page_section.value == false -%}
    {%- include 'LP-PTO-object-testimonial-new' -%}
  {%- endif -%}
{%- elsif page.metafields.custom.index_testimonial_item_selection != blank -%}
  {%- assign index_testimonial_item_selection = page.metafields.custom.index_testimonial_item_selection.value -%}
  {%- if index_testimonial_item_selection.main_home_page_section.value == false -%}
    {%- include 'LP-PTO-object-testimonial-new' -%}
  {%- endif -%}
{%- elsif collection.metafields.custom.index_testimonial_item_selection != blank -%}
  {%- assign index_testimonial_item_selection = collection.metafields.custom.index_testimonial_item_selection.value -%}
  {%- if index_testimonial_item_selection.main_home_page_section.value == false -%}
    {%- include 'LP-PTO-object-testimonial-new' -%}
  {%- endif -%}
{%- else -%}
  {%- assign index_testimonial_item_selection = shop.metaobjects.index_testimonial_item_selection -%}
  {%- paginate shop.metaobjects.index_testimonial_item_selection.values by 1000 -%}
    {%- for index_testimonial_item_selection in index_testimonial_item_selection.values -%}
      {%- if index_testimonial_item_selection.main_home_page_section.value == true -%}
        {%- include 'LP-PTO-object-testimonial-new' -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endpaginate -%}  
{%- endif -%}

{% schema %}
  {
    "name": "LP PTO Object Testimonial",
    "class": "LP_PTO_object_testimonial_new",
    "settings": [
      {
        "type": "color",
        "id": "main_background_color",
        "label": "Add Main Background Color",
        "default": "#FFFFFF"
      }
    ],
    "presets": [
      {
        "name": "LP PTO Object Testimonial"
      }
    ]
  }
{% endschema %}