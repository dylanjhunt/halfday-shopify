{%- if section.settings.main_common_video != blank or section.settings.main_desktop_image != blank or section.settings.main_mobile_image != blank or section.settings.main_heading_text != blank or section.blocks.size > 0 or section.settings.main_button_link != blank -%}
  <div class="Index_image_accordion_main_new" style="background: {{ section.settings.main_background_color }};">
    <div class="Index_image_accordion_inner_new">
      <div class="Index_image_accordion_sides_new">
        {%- if section.settings.main_common_video != blank or section.settings.main_desktop_image != blank or section.settings.main_mobile_image != blank -%}
          <div class="Index_image_accordion_sides_mainleft_new">
            <div class="Index_image_accordion_sides_innerleft_new">
              {%- if section.settings.main_common_video != blank -%}
                <div class="Index_image_accordion_sides_innerleft_videoimage_new">
                  {{ section.settings.main_common_video | video_tag: class:'Common_video_new', image_size: 'master', controls: false, autoplay: true, loop: true }}
                </div>
              {% else %}  
                {%- if section.settings.main_desktop_image != blank and section.settings.main_mobile_image != blank -%}
                  <div class="Index_image_accordion_sides_innerleft_videoimage_new">
                    {%- if section.settings.main_desktop_image != blank -%}
                      {{
                        section.settings.main_desktop_image | 
                        image_url: width: img.width | 
                        image_tag: widths: '750, 900, 1080, 1296, 1512, 1728, 1944, 2048', 
                        fetchpriority: 'low', 
                        class:'Desktop_image_new'
                      }}
                    {%- endif -%}
                    {%- if section.settings.main_mobile_image != blank -%}
                      {{
                        section.settings.main_mobile_image | 
                        image_url: width: img.width | 
                        image_tag: widths: '750, 900, 1080, 1296, 1512, 1728, 1944, 2048', 
                        fetchpriority: 'low', 
                        class:'Mobile_image_new'
                      }}
                    {%- endif -%}
                  </div>
                {%- endif -%}
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
        {%- if section.settings.main_heading_text != blank or section.blocks.size > 0 or section.settings.main_button_link != blank -%}
          <div class="Index_image_accordion_sides_mainright_new">
            <div class="Index_image_accordion_sides_innerright_new">
              {%- if section.settings.main_heading_text != blank -%}
                <div class="Index_image_accordion_sides_innerright_maintitle_new">
                  <div class="Common_title_new Index_image_accordion_sides_innerright_innertitle_new">
                    <h2>{{ section.settings.main_heading_text }}</h2>
                  </div>
                </div>
              {%- endif -%}
              {%- if section.blocks.size > 0 -%}
                <div class="Index_image_accordion_sides_innerright_mainloops_new">
                  <div class="Index_image_accordion_sides_innerright_innerloops_new">
                    <div class="accordion">
                      <ul class="list-unstyled">
                        {%- for block in section.blocks -%}
                          {%- if block.settings.title != blank and block.settings.main_custom_infos != blank -%}
                            <li{% if forloop.first %} class="open"{% endif %}>
                              {%- if block.settings.main_custom_image != blank or block.settings.title != blank -%}
                                <div class="question">
                                  <div class="Index_image_accordion_sides_innerright_innerloops_mainquestion_new">
                                    <div class="Index_image_accordion_sides_innerright_innerloops_innerquestion_new">
                                      {%- if block.settings.main_custom_image != blank -%}
                                        <div class="Index_image_accordion_sides_innerright_innerloops_innerquestion_image_new">
                                          {{
                                            block.settings.main_custom_image | 
                                            image_url: width: img.width | 
                                            image_tag: widths: '750, 900, 1080, 1296, 1512, 1728, 1944, 2048', 
                                            fetchpriority: 'low', 
                                            class: 'Custom_image_new'
                                          }}
                                        </div>
                                      {%- endif -%}
                                      {%- if block.settings.title != blank -%}
                                        <div class="Index_image_accordion_sides_innerright_innerloops_innerquestion_title_new">
                                          {{ block.settings.title }}
                                        </div>
                                      {%- endif -%}
                                    </div>
                                  </div>
                                </div>
                              {%- endif -%}
                              {%- if block.settings.main_custom_infos != blank -%}
                                <div class="answer"{% if forloop.first %} style="display: block;"{% endif %}>
                                  <div class="Index_image_accordion_sides_innerright_innerloops_mainanswer_new">
                                    <div class="Index_image_accordion_sides_innerright_innerloops_inneranswer_new">
                                      {{ block.settings.main_custom_infos }}
                                    </div>
                                  </div>
                                </div>
                              {%- endif -%}
                            </li>
                          {%- endif -%}  
                        {%- endfor -%}
                      </ul>
                    </div>
                  </div>
                </div>
              {%- endif -%}
              {%- if section.settings.main_button_text != blank and section.settings.main_button_link != blank -%}
                <div class="Index_image_accordion_sides_innerright_mainbutton_new">
                  <div class="Index_image_accordion_sides_innerright_innerbutton_new">
                    <a href="{{ section.settings.main_button_link }}" class="button">
                      {{ section.settings.main_button_text }}
                    </a>
                  </div>
                </div>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
{%- endif -%}  

{% schema %}
  {
    "name": "Index Image Accordion New",
    "class": "Index_image_accordion_new",
    "settings": [
      {
        "type": "color",
        "id": "main_background_color",
        "label": "Add Main Background Color",
        "default": "#FF5528"
      },
      {
        "type": "video",
        "id": "main_common_video",
        "label": "Add Main Common Video"
      },
      {
        "type": "image_picker",
        "id": "main_desktop_image",
        "label": "Add Main Desktop Image"
      },
      {
        "type": "image_picker",
        "id": "main_mobile_image",
        "label": "Add Main Mobile Image"
      },
      {
        "type": "textarea",
        "id": "main_heading_text",
        "label": "Add Main Heading Text",
        "default": "Re-live the moments that make life sweet"
      },
      {
        "type": "text",
        "id": "main_button_text",
        "label": "Add Main Button Text",
        "default": "Why Halfday"
      },
      {
        "type": "url",
        "id": "main_button_link",
        "label": "Add Main Button Link",
        "default": "/"
      }
    ],
    "blocks": [
      {
        "type": "information",
        "name": "Information",
        "settings": [
          {
            "type": "image_picker",
            "id": "main_custom_image",
            "label": "Add Main Custom Image"
          },
          {
            "type": "textarea",
            "id": "title",
            "label": "Add Main Custom Title",
            "default": "Lorem Ipsum is simply dummy"
          },
          {
            "type": "richtext",
            "id": "main_custom_infos",
            "label": "Add Main Custom Infos",
            "default": "<p>Lorem Ipsum is simply dummy text of the printing and typesetting industry.</p>"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Index Image Accordion New",
        "blocks": [
          {
            "type": "information"
          },
          {
            "type": "information"
          },
          {
            "type": "information"
          },
          {
            "type": "information"
          }
        ]
      }
    ]
  }
{% endschema %}