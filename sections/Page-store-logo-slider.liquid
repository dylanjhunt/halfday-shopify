{%- if section.blocks.size > 0 -%}
  <div class="Index_store_logo_slider_main_new Page_store_logo_slider_main Page_store_logo_slider_main_{{ section.id }}" style="background: {{ section.settings.main_background_color }};">
    <div class="Index_store_logo_slider_inner_new">
      {%- if section.settings.main_heading_text != blank -%}
        <div class="Index_store_logo_slider_maintitle_new">
          <div class="Index_store_logo_slider_innertitle_new">
            <h2>{{ section.settings.main_heading_text }}</h2>
          </div>
        </div>
      {%- endif -%}
      {% comment %}
      {%- if section.blocks.size > 0 -%}
        <div class="Index_store_logo_slider_maindesktop_new Desktop_only_new">
          <div class="Index_store_logo_slider_innerdesktop_new">
            <div class="swiper Index_store_logo_slider_innerdesktop_slider">
              <div class="swiper-wrapper">
                {%- for block in section.blocks -%}
                  {%- if block.settings.main_custom_image != blank -%}
                    <div class="swiper-slide Index_store_logo_slider_innerdesktop_mainboxs_new">
                      {%- if block.settings.main_custom_links != blank -%}
                        <a href="{{ block.settings.main_custom_links }}" target="_blank">
                      {%- endif -%}  
                          <div class="Index_store_logo_slider_innerdesktop_innerboxs_new">
                            {{
                              block.settings.main_custom_image | 
                              image_url: width: img.width | 
                              image_tag: widths: '750, 900, 1080, 1296, 1512, 1728, 1944, 2048', 
                              fetchpriority: 'high', 
                              class: 'Custom_image_new'
                            }}
                          </div>
                      {%- if block.settings.main_custom_links != blank -%}
                        </a>
                      {%- endif -%}
                    </div>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </div>
          </div>
        </div>
      {%- endif -%}
      {% endcomment %}
      {%- if section.blocks.size > 0 -%}
        <div class="Index_store_logo_slider_mainmobile_new">
          <div class="Index_store_logo_slider_innermobile_new">
            <div class="swiper Index_store_logo_slider_innermobile_marquee">
              <div class="swiper-wrapper">
                {%- for block in section.blocks -%}
                  {%- if block.settings.main_custom_image != blank -%}
                    <div class="swiper-slide Index_store_logo_slider_innermobile_mainboxs_new">
                      {%- if block.settings.main_custom_links != blank -%}
                        <a href="{{ block.settings.main_custom_links }}" target="_blank">
                      {%- endif -%}  
                          <div class="Index_store_logo_slider_innermobile_innerboxs_new">
                            {{
                              block.settings.main_custom_image | 
                              image_url: width: img.width | 
                              image_tag: widths: '750, 900, 1080, 1296, 1512, 1728, 1944, 2048', 
                              fetchpriority: 'high', 
                              class: 'Custom_image_new'
                            }}
                          </div>
                      {%- if block.settings.main_custom_links != blank -%}
                        </a>
                      {%- endif -%}
                    </div>  
                  {%- endif -%}
                {%- endfor -%}
                {%- for block in section.blocks -%}
                  {%- if block.settings.main_custom_image != blank -%}
                    <div class="swiper-slide Index_store_logo_slider_innermobile_mainboxs_new">
                      {%- if block.settings.main_custom_links != blank -%}
                        <a href="{{ block.settings.main_custom_links }}" target="_blank">
                      {%- endif -%}  
                          <div class="Index_store_logo_slider_innermobile_innerboxs_new">
                            {{
                              block.settings.main_custom_image | 
                              image_url: width: img.width | 
                              image_tag: widths: '750, 900, 1080, 1296, 1512, 1728, 1944, 2048', 
                              fetchpriority: 'high', 
                              class: 'Custom_image_new'
                            }}
                          </div>
                      {%- if block.settings.main_custom_links != blank -%}
                        </a>
                      {%- endif -%}
                    </div>  
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </div>
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}      

<style>
  .Page_store_logo_slider_main { padding: 40px 0; }
  .Page_store_logo_slider_main .Index_store_logo_slider_maindesktop_new { width: 100%; padding-left: 0; }
  .Page_store_logo_slider_main .Index_store_logo_slider_innerdesktop_slider { padding: 0 56px; }
  .Page_store_logo_slider_main .Index_store_logo_slider_mainmobile_new { padding-left: 0; width: 100%; }

  @media (max-width: 749px){
    .Page_store_logo_slider_main { padding: 32px 0; }
    .Page_store_logo_slider_main .Index_store_logo_slider_mainmobile_new { padding-top: 0; }
  }
  
</style>

{% schema %}
  {
    "name": "Page Store Logo Slider",
    "class": "Page_store_logo_slider",
    "settings": [
      {
        "type": "color",
        "id": "main_background_color",
        "label": "Add Main Background Color",
        "default": "#FF5528"
      }
    ],
    "blocks": [
      {
        "type": "information",
        "name": "Information",
        "settings": [
          {
            "type": "image_picker",
            "id": "main_custom_image",
            "label": "Add Main Custom Image"
          },
          {
            "type": "url",
            "id": "main_custom_links",
            "label": "Add Main Custom Links"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Page Store Logo Slider",
        "blocks": [
          {
            "type": "information"
          },
