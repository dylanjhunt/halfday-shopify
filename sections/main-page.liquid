{{ 'section-main-page.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px !Important;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px !Important;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px !Important;
      padding-bottom: {{ section.settings.padding_bottom }}px !Important;
    }
  }
{%- endstyle -%}

<div class="page-width page-width--narrow section-{{ section.id }}-padding {% if page.title == "Privacy Policy" or "Terms of Service" %}Privacy_policy_page{% endif %}">
  <h1 class="main-page-title page-title h0{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
    {{ page.title | escape }}
  </h1>
  <div class="rte{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
    {{ page.content }}
  </div>
</div>

<style>
  .Privacy_policy_page { max-width: 1068px; width: 100%; margin: 0 auto; }
  .Privacy_policy_page h1 { color: #ff5528; text-align: center; font-family: Strippy; font-size: 72px; line-height: 100%; letter-spacing: 2.88px; margin: 0 0 56px; }
  .Privacy_policy_page p, .Privacy_policy_page li { margin: 0; font-size: 18px; line-height: 120%; font-weight: 700; letter-spacing: 0.36px; color: #004600; font-family: var(--font-museo-sans-family); }
  .Privacy_policy_page h4 { margin: 32px 0 12px; text-transform: uppercase; font-weight: 800; font-family: var(--font-museo-slab-family); font-size: 24px; line-height: 115%; letter-spacing: 0.96px; color: #004600; }
  .Privacy_policy_page p strong { display: block; margin-top: 24px; font-weight: 800; font-family: var(--font-museo-slab-family); }
  .Privacy_policy_page ul { margin: 8px 0; list-style: none; padding: 0; }
  .Privacy_policy_page li { position: relative; padding-left: 20px; }
  .Privacy_policy_page li:before { content: ""; position: absolute; width: 6px; height: 6px; border-radius: 50%; background-color: #004600; left: 6px; top: 7px; }
  .Privacy_policy_page a { color: #004600; }
  .Privacy_policy_page table:not([class]) td, .Privacy_policy_page table:not([class]) th { border: none; }
  

  @media (max-width: 1439px) {
    .Privacy_policy_page h1 { font-size: 48px; }
}

  @media (max-width: 749px){
    .Privacy_policy_page { padding-top: 40px !Important; padding-bottom: 56px !important; }
    .Privacy_policy_page h1 { margin: 0 0 32px; }
    .Privacy_policy_page h4 { font-size: 18px; letter-spacing: 0.72px; }
    .Privacy_policy_page table { width: 800px; border: 1px solid rgba(var(--color-foreground), .2); }
    .Privacy_policy_page div:has(> table) { overflow-x: scroll; }
    .Privacy_policy_page table p { font-size: 16px; }
    
  }
</style>

{% schema %}
{
  "name": "t:sections.main-page.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}
