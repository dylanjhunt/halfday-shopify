</svg>
  </div>
              <label for="RegisterForm-password">
                {{ 'customer.register.password' | t }}
              </label>
              
            </div>
            {%- if form.errors contains 'password' -%}
              <span id="RegisterForm-password-error" class="form__message">
                <span class="svg-wrapper">
                  {{- 'icon-error.svg' | inline_asset_content -}}
                </span>
                {{ form.errors.translated_fields.password | capitalize }}
                {{ form.errors.messages.password }}.
              </span>
            {%- endif -%}
            <button class="button">
              {{ 'customer.register.submit' | t }}
            </button>
          {%- endform -%}
        </div>
        {% if section.settings.bottom_text != blank %}
          <div class="register_main_section_bottom_text">
            {{ section.settings.bottom_text }}
          </div>
        {% endif %}
        <div class="register_main_section_login_link_container">
          <p>
            Already a member? 
            <a href="/collections/employee-shop">
              {{ 'customer.login_page.sign_in' | t }}
            </a>
          </p>
        </div>
        
      </div>
    </div>
  </div>
</div>

<style>
  .register_main_section_sides { display: flex; }
  .register_main_section_leftmain { width: 50%; padding: 80px 78px; }
  .register_main_section_rightmain { width: 50%; padding: 40px 100px; }
  .register_main_section_leftinner { height: 100%; }
  .register_main_section_main_image { width: 100%; height: 100%; }
  .register_main_section_main_image img { width: 100%; height: 100% !important; display: block; object-fit: cover; }
  .register_main_section_rightinner { height: 100%; display: flex; flex-direction: column; justify-content: center; }
  .register_main_section_bottom_text { padding-top: 16px; }
  .register_main_section_bottom_text p { margin: 0; text-align: center; color: #004600; font-family: var(--font-museo-sans-family); font-size: 14px; font-weight: 600; line-height: 130%; letter-spacing: 0.28px;}
  .register_main_section_bottom_text a { color: #004600; }
  .register_main_section_login_link_container { padding-top: 32px; }
  .register_main_section_login_link_container p { margin: 0; text-align: center; color: #004600; font-family: var(--font-museo-slab-family); font-size: 14px; font-weight: 800; line-height: 135%; letter-spacing: 0.28px; text-transform: uppercase;}
  .register_main_section_login_link_container a { color: #004600; }
  
  .register_main_section .register { padding: 0 !important; max-width: 520px !important; }
  .register_main_section .register-sub-title { padding-top: 32px; }
  .register_main_section .register-sub-title p:not(:first-child) { margin-top: 8px; }
  .register_main_section .customer form { margin: 32px 32px 0;}
  .register_main_section .customer form .field { margin: 0 0 8px 0; }
  .register_main_section .customer form .field:before, .register_main_section .customer form .field:after { display: none; }
  .register_main_section .customer form input { height: 48px; padding: 12px 20px; border-radius: 99px; border: 2px solid #004600; margin: 0; }
  .register_main_section .customer form input:focus, .register_main_section .customer .field input:not(:placeholder-shown) { margin: 0; padding: 12px 20px; }
  .register_main_section .customer form label { display: none; }
  .register_main_section .customer form input::placeholder { opacity: 1; }
  .register_main_section .customer form input, .register_main_section .customer form input::placeholder { font-family: var(--font-museo-slab-family) !important; color: #004600; font-size: 16px; font-weight: 800; line-height: 135%; letter-spacing: 0.32px; text-transform: uppercase;}
  .register_main_section .customer form .button {  width: 100%; margin: 0; font-family: var(--font-museo-slab-family); border-radius: 99px; color: #fff; text-align: center; font-size: 16px; line-height: 22px; letter-spacing: .32px; text-transform: uppercase; padding: 13px; display: inline-block; min-height: initial; font-weight: 800; }
  .register_main_section .customer form .form__message { margin-bottom: 20px; }
  
  @media (min-width: 990px) and (max-width: 1439px) {
    .register_main_section_leftmain { padding: 40px; }
    .register_main_section_rightmain { padding: 40px; }
    .register_main_section .customer form .button { font-size: 12px; padding: 15px; min-height: 45px; }
  }

  @media (max-width: 989px){
    .register_main_section_rightmain { padding: 30px 20px; }
    .register_main_section_leftmain { padding: 30px; }
    .register_main_section .register-sub-title p { font-size: 18px; line-height: 120%; }
    .register_main_section .customer form { margin: 32px 0 0; }
  }

  @media (max-width: 749px){
    .register_main_section_sides { flex-direction: column-reverse; }
    .register_main_section_rightmain { width: 100%; padding: 40px 20px 56px; }
    .register_main_section_leftmain { width: 100%; padding: 41.67px 40.62px 41px; }
    .register_main_section_main_image { aspect-ratio: 0.8813; }
  }
  
</style>


{% schema %}
{
  "name": "t:sections.main-register.name",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Add Main Image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Add Main Image - Mobile"
    },
    {
      "type": "color",
      "id": "image_bg_color",
      "label": "Add Image Background Color",
      "default": "#FF5528"
    },
    {
      "type": "richtext",
      "id": "bottom_text",
      "label": "Add Bottom Text",
      "default": "<p>If you don't receive an email within 24 hours, please reach out to jessica@drinkhalfday.com.</p>"
    }
  ]
}
{% endschema %}
