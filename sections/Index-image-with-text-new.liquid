{%- if section.settings.main_common_video != blank or section.settings.main_desktop_image != blank or section.settings.main_mobile_image != blank or section.settings.main_heading_text != blank or section.settings.main_details_text != blank or section.settings.main_button_link != blank -%}
  <div class="Index_image_with_text_main_new" style="background: {{ section.settings.main_background_color }};">
    <div class="page-width">
      <div class="Index_image_with_text_inner_new">
        <div class="Index_image_with_text_sides_new">
          {%- if section.settings.main_common_video != blank or section.settings.main_desktop_image != blank or section.settings.main_mobile_image != blank -%}
            <div class="Index_image_with_text_sides_mainleft_new">
              <div class="Index_image_with_text_sides_innerleft_new">
                {%- if section.settings.main_common_video != blank -%}
                  <div class="Index_image_with_text_sides_innerleft_videoimage_new">
                    {{ section.settings.main_common_video | video_tag: class:'Common_video_new', image_size: 'master', controls: false, autoplay: true, loop: true }}
                  </div>
                {% else %}  
                  {%- if section.settings.main_desktop_image != blank and section.settings.main_mobile_image != blank -%}
                    <div class="Index_image_with_text_sides_innerleft_videoimage_new">
                      {%- if section.settings.main_desktop_image != blank -%}
                        {{
                          section.settings.main_desktop_image | 
                          image_url: width: img.width | 
                          image_tag: widths: '750, 900, 1080, 1296, 1512, 1728, 1944, 2048', 
                          fetchpriority: 'low', 
                          class:'Desktop_image_new'
                        }}
                      {%- endif -%}
                      {%- if section.settings.main_mobile_image != blank -%}
                        {{
                          section.settings.main_mobile_image | 
                          image_url: width: img.width | 
                          image_tag: widths: '750, 900, 1080, 1296, 1512, 1728, 1944, 2048', 
                          fetchpriority: 'low', 
                          class:'Mobile_image_new'
                        }}
                      {%- endif -%}
                    </div>
                  {%- endif -%}
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}
          {%- if section.settings.main_heading_text != blank or section.settings.main_details_text != blank or section.settings.main_button_link != blank -%}
            <div class="Index_image_with_text_sides_mainright_new">
              <div class="Index_image_with_text_sides_innerright_new">
                {%- if section.settings.main_heading_text != blank -%}
                  <div class="Index_image_with_text_sides_innerright_maintitle_new">
                    <div class="Common_large_title_new Index_image_with_text_sides_innerright_innertitle_new">
                      <h2>{{ section.settings.main_heading_text }}</h2>
                    </div>
                  </div>
                {%- endif -%}
                {%- if section.settings.main_details_text != blank -%}
                  <div class="Index_image_with_text_sides_innerright_maininfos_new">
                    <div class="Common_infos_new Index_image_with_text_sides_innerright_innerinfos_new">
                      {{ section.settings.main_details_text }}
                    </div>
                  </div>
                {%- endif -%}  
                {%- if section.settings.main_button_text != blank and section.settings.main_button_link != blank -%}
                  <div class="Index_image_with_text_sides_innerright_mainbutton_new">
                    <div class="Index_image_with_text_sides_innerright_innerbutton_new">
                      <a href="{{ section.settings.main_button_link }}" class="button">
                        {{ section.settings.main_button_text }}
                      </a>
                    </div>
                  </div>
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
  {
    "name": "Index Image With Text New",
    "class": "Index_image_with_text_new",
    "settings": [
      {
        "type": "color",
        "id": "main_background_color",
        "label": "Add Main Background Color",
        "default": "#FFFFFF"
      },
      {
        "type": "video",
        "id": "main_common_video",
        "label": "Add Main Common Video"
      },
      {
        "type": "image_picker",
        "id": "main_desktop_image",
        "label": "Add Main Desktop Image"
      },
      {
        "type": "image_picker",
        "id": "main_mobile_image",
        "label": "Add Main Mobile Image"
      },
      {
        "type": "textarea",
        "id": "main_heading_text",
        "label": "Add Main Heading Text",
        "default": "A glass half full"
      },
      {
        "type": "richtext",
        "id": "main_details_text",
        "label": "Add Main Details Text",
        "default": "<p>After being diagnosed with Ulcerative Colitis, Kayvon joined bestie Mike to make gut-friendly iced teas inspired by their childhood favorite flavors.</p>"
      },
      {
        "type": "text",
        "id": "main_button_text",
        "label": "Add Main Button Text",
        "default": "Our Story"
      },
      {
        "type": "url",
        "id": "main_button_link",
        "label": "Add Main Button Link",
        "default": "/"
      }
    ],
    "presets": [
      {
        "name": "Index Image With Text New"
      }
    ]
  }
{% endschema %}