
<div class="get-free-call">
  <div class="page-width">
     {%- if section.settings.heading != blank -%}
       <h2 class="heading">
         {{ section.settings.heading }}
       </h2>
     {%- endif -%}

    <div class="form-section">
      <form>
         {%- if section.settings.form_heading != blank -%}
          <div class="form-heading">{{ section.settings.form_heading }}</div>
         {%- endif -%}
         <input type="number" name="phone" placeholder="PHONE NUMBER" />
         <button class="button">SEND</button>
      </form>
    </div>
    
    {%- if section.blocks.size > 0 -%}
     <div class="get-free-call-inner">
       {%- for block in section.blocks -%}
          <div class="block">
             {{ block.settings.image }}
             <div class="text">{{ block.settings.text }}</div>
          </div>
       {%- endfor -%}
     </div>
    {%- endif -%}
    
  </div>
</div>

{% schema %}
  {
    "name": "Get Free Call",
    "settings": [
       {
         "type": "text",
         "id": "heading",
         "label": "Heading"
       },
       {
         "type": "text",
         "id": "form_heading",
         "label": "Form Heading"
       }
    ],
     "blocks": [
      {
        "type": "block",
        "name": "block",
        "settings": [
          {
            "type": "textarea",
            "id": "image",
            "label": "Image"
          },
          {
            "type": "text",
            "id": "text",
            "label": "Text"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Get Free Call"
      }
    ]
  }
{% endschema %}