                                      </div>
                                      <div class="Index_object_testimonials_innerloops_innerdetail_innerboths_title_new">
                                        {{ collection_grid_testimonials_selections.main_custom_author_text.value }}
                                      </div>
                                    </div>
                                  </div>
                                {%- endif -%}  
                              </div>
                            </div>
                          {%- endif -%}
                        </div>
                        </div>
                      </collection-grid-item>
                    {%- endif -%}
                  {%- endfor -%}
                {%- endif -%}
                {%- if collection.metafields.custom.collection_custom_grid_item_selections.value != blank -%}
                  {%- for collection_custom_grid_item_selections in collection.metafields.custom.collection_custom_grid_item_selections.value -%}
                    {%- if collection_custom_grid_item_selections.main_common_banner_video_or_image.value != blank -%}
                    <collection-grid-item 
                      data-hb-position-desk="{{ collection_custom_grid_item_selections.desktop_position }}"
                      data-hb-position-mob="{{ collection_custom_grid_item_selections.mobile_position }}"
                      class="hidden">
                      <div class="grid__item Collection_template_innerdetails_loops_mainbanner_new">
                        <div class="Collection_template_innerdetails_loops_innerbanner_new">
                          {%- if collection_custom_grid_item_selections.main_common_banner_redirect_link.value != blank -%}
                            <a href="{{ collection_custom_grid_item_selections.main_common_banner_redirect_link.value }}">
                          {%- endif -%}
                              {%- if collection_custom_grid_item_selections.main_common_banner_video_or_image.value contains "files" -%}
                                <div class="Collection_template_innerdetails_loops_innerbanner_imagevideo_new">
                                  {{
                                    collection_custom_grid_item_selections.main_common_banner_video_or_image.value | 
                                    image_url: width: img.width | 
                                    image_tag: widths: '750, 900, 1080, 1296, 1512, 1728, 1944, 2048', 
                                    fetchpriority: 'high', 
                                    class: 'Static_image_new'
                                  }}
                                </div>
                              {%- else -%}
                                <div class="Collection_template_innerdetails_loops_innerbanner_imagevideo_new">
                                  {{ collection_custom_grid_item_selections.main_common_banner_video_or_image.value | video_tag: class:'Static_video_new', image_size: 'master', controls: false, autoplay: true, loop: true }}
                                </div>
                              {%- endif -%}
                          {%- if collection_custom_grid_item_selections.main_common_banner_redirect_link.value != blank -%}
                            </a>
                          {%- endif -%}
                        </div>
                      </div>
                        
                      </collection-grid-item>
                    {%- elsif collection_custom_grid_item_selections.main_desktop_video_or_image.value != blank and collection_custom_grid_item_selections.main_mobile_video_or_image.value != blank -%}
                      <collection-grid-item 
                      data-hb-position-desk="{{ collection_custom_grid_item_selections.desktop_position }}"
                      data-hb-position-mob="{{ collection_custom_grid_item_selections.mobile_position }}"
                      class="hidden">
                      <div class="grid__item Collection_template_innerdetails_loops_mainblock_new">
                        <div class="Collection_template_innerdetails_loops_innerbanner_new">
                        {%- if collection_custom_grid_item_selections.main_common_redirect_link.value != blank -%}
                          <a href="{{ collection_custom_grid_item_selections.main_common_redirect_link.value }}">
                        {%- endif -%}
                            <div class="Collection_template_innerdetails_loops_innerblock_new">
                              {%- if collection_custom_grid_item_selections.main_desktop_video_or_image.value != blank -%}
                                <div class="Collection_template_innerdetails_loops_innerblock_mainstatic_new Desktop_only_new">
                                  <div class="Collection_template_innerdetails_loops_innerblock_innerstatic_new">
                                    {%- if collection_custom_grid_item_selections.main_desktop_video_or_image.value contains "files" -%}
                                      <div class="Collection_template_innerdetails_loops_innerblock_innerstatic_imagevideo_new">
                                        {{
                                          collection_custom_grid_item_selections.main_desktop_video_or_image.value | 
                                          image_url: width: img.width | 
                                          image_tag: widths: '750, 900, 1080, 1296, 1512, 1728, 1944, 2048', 
                                          fetchpriority: 'low', 
                                          class: 'Static_image_new'
                                        }}
                                      </div>
                                    {%- else -%}
                                      <div class="Collection_template_innerdetails_loops_innerblock_innerstatic_imagevideo_new">
                                        {{ collection_custom_grid_item_selections.main_desktop_video_or_image.value | video_tag: class:'Static_video_new', image_size: 'master', controls: false, autoplay: true, loop: true }}
                                      </div>
                                    {%- endif -%}
                                  </div>
                                </div>
                              {%- endif -%}
                              {%- if collection_custom_grid_item_selections.main_mobile_video_or_image.value != blank -%}
                                <div class="Collection_template_innerdetails_loops_innerblock_mainstatic_new Mobile_only_new">
                                  <div class="Collection_template_innerdetails_loops_innerblock_innerstatic_new">
                                    {%- if collection_custom_grid_item_selections.main_mobile_video_or_image.value contains "files" -%}
                                      <div class="Collection_template_innerdetails_loops_innerblock_innerstatic_imagevideo_new">
                                        {{
                                          collection_custom_grid_item_selections.main_mobile_video_or_image.value | 
                                          image_url: width: img.width | 
                                          image_tag: widths: '750, 900, 1080, 1296, 1512, 1728, 1944, 2048', 
                                          fetchpriority: 'low', 
                                          class: 'Static_image_new'
                                        }}
                                      </div>
                                    {%- else -%}
                                      <div class="Collection_template_innerdetails_loops_innerblock_innerstatic_imagevideo_new">
                                        {{ collection_custom_grid_item_selections.main_mobile_video_or_image.value | video_tag: class:'Static_video_new', image_size: 'master', controls: false, autoplay: true, loop: true }}
                                      </div>
                                    {%- endif -%}
                                  </div>
                                </div>
                              {%- endif -%}
                              {%- if collection_custom_grid_item_selections.main_common_heading_text.value != blank or collection_custom_grid_item_selections.main_common_redirect_text.value != blank -%}
                                <div class="Collection_template_innerdetails_loops_innerblock_mainoverlay_new">
                                  <div class="Collection_template_innerdetails_loops_innerblock_inneroverlay_new">
                                    {%- if collection_custom_grid_item_selections.main_common_heading_text.value != blank -%}
                                      <div class="Collection_template_innerdetails_loops_innerblock_inneroverlay_maintitle_new">
                                        <div class="Collection_template_innerdetails_loops_innerblock_inneroverlay_innertitle_new">
                                          <h2>{{ collection_custom_grid_item_selections.main_common_heading_text.value }}</h2>
                                        </div>
                                      </div>
                                    {%- endif -%}
                                    {%- if collection_custom_grid_item_selections.main_common_redirect_text.value != blank -%}
                                      <div class="Collection_template_innerdetails_loops_innerblock_inneroverlay_mainbutton_new">
                                        <div class="Collection_template_innerdetails_loops_innerblock_inneroverlay_innerbutton_new button button_yellow_new">
                                          {{ collection_custom_grid_item_selections.main_common_redirect_text.value }}
                                        </div>
                                      </div>
                                    {%- endif -%}
                                  </div>
                                </div>
                              {%- endif -%}
                            </div>
                        {%- if collection_custom_grid_item_selections.main_common_redirect_link.value != blank -%}
                          </a>
                        {%- endif -%}
                        </div>
                      </div>
                        
                      </collection-grid-item>
                    {%- endif -%}  
                  {%- endfor -%}  
                {%- endif -%}
              </ul>
  
              {%- if paginate.pages > 1 -%}
                {% render 'pagination', paginate: paginate, anchor: '' %}
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      </div>
    {%- endpaginate -%}
    {% if section.settings.image_shape == 'arch' %}
      {{ 'mask-arch.svg' | inline_asset_content }}
    {%- endif -%}
  </div>
</div>

