                          {{ link.title }}
                        </a>
                      {%- endif -%}   
                    </li>
                  {%- endfor -%}
                </ul>
              </div>
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
  {
    "name": "LP Footer Latest New",
    "class": "LP_Footer_latest_new",
    "settings": [
      {
        "type": "color",
        "id": "main_background_color",
        "label": "Add Main Background Color",
        "default": "#FFE700"
      },
      {
        "type": "image_picker",
        "id": "main_custom_logo",
        "label": "Add Main Custom Logo"
      },
      {
        "type": "link_list",
        "id": "main_desktop_menu",
        "label": "Add Main Desktop Menu"
      },
      {
        "type": "link_list",
        "id": "main_mobile_menu_1",
        "label": "Add Main Mobile Menu-1"
      },
      {
        "type": "link_list",
        "id": "main_mobile_menu_2",
        "label": "Add Main Mobile Menu-2"
      }
    ],
    "blocks": [
      {
        "type": "social_link_list",
        "name": "Social Link List",
        "settings": [
          {
            "type": "image_picker",
            "id": "main_social_icon",
            "label": "Add Main Social Icon"
          }, 
          {
            "type": "url",
            "id": "main_social_link",
            "label": "Add Main Social Link"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "LP Footer Latest New"
      }
    ]
  }
{% endschema %}