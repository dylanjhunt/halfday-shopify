{%- if section.settings.main_desktop_menu != blank or section.settings.main_mobile_menu != blank or section.settings.main_button_link != blank or section.settings.main_redirect_link != blank or section.blocks.size > 0 or section.settings.main_custom_logo != blank -%}
  <div class="LP_Header_latest_main_new" style="background: {{ section.settings.main_background_color }};">
    <div class="page-width">
      <div class="LP_Header_latest_inner_new">
        <div class="LP_Header_latest_sides_new">
          {%- if section.settings.main_desktop_menu != blank -%}
            <div class="LP_Header_latest_sides_mainleft_new Desktop_only_new">
              <div class="LP_Header_latest_sides_innerleft_new">
                <ul>
                  {%- for link in section.settings.main_desktop_menu.links -%}
                    {%- comment %}<locksmith:9847>{% endcomment -%}
                      {%- capture var %}{% render 'locksmith-variables', scope: 'subject', subject: link, subject_parent: section.settings.main_desktop_menu, variable: 'transparent' %}{% endcapture %}{% if var == "true" %}{% else %}{% continue %}{% endif -%}
                    {%- comment %}</locksmith:9847>{% endcomment -%}
                    <li>
                      <a href="{{ link.url }}" target="_blank">
                        {{ link.title }}  
                      </a>
                    </li>
                  {%- endfor -%}
                </ul>
              </div>
            </div>
          {%- endif -%}
          {%- if section.settings.main_mobile_menu != blank or section.settings.main_button_link != blank or section.settings.main_redirect_link != blank or section.blocks.size > 0 -%}
            <div class="LP_Header_latest_sides_mainleft_new Mobile_only_new">
              <div class="">
                <div class="LP_Header_latest_sides_innerleft_mainicons_new">
                  <div class="LP_Header_latest_sides_innerleft_innericons_new">
                    <span class="Lines_custom_new"><svg width="28" height="28" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M23.3333 12.8333H4.66667C3.96667 12.8333 3.5 13.3 3.5 14C3.5 14.7 3.96667 15.1667 4.66667 15.1667H23.3333C24.0333 15.1667 24.5 14.7 24.5 14C24.5 13.3 24.0333 12.8333 23.3333 12.8333ZM4.66667 9.33333H23.3333C24.0333 9.33333 24.5 8.86667 24.5 8.16667C24.5 7.46667 24.0333 7 23.3333 7H4.66667C3.96667 7 3.5 7.46667 3.5 8.16667C3.5 8.86667 3.96667 9.33333 4.66667 9.33333ZM23.3333 18.6667H4.66667C3.96667 18.6667 3.5 19.1333 3.5 19.8333C3.5 20.5333 3.96667 21 4.66667 21H23.3333C24.0333 21 24.5 20.5333 24.5 19.8333C24.5 19.1333 24.0333 18.6667 23.3333 18.6667Z" fill="#004600"/></svg></span>
                    <span class="Close_custom_new"><svg width="28" height="28" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M15.6451 14L20.6617 8.99501C20.8814 8.77533 21.0048 8.47736 21.0048 8.16668C21.0048 7.85599 20.8814 7.55803 20.6617 7.33835C20.442 7.11866 20.1441 6.99524 19.8334 6.99524C19.5227 6.99524 19.2247 7.11866 19.0051 7.33835L14.0001 12.355L8.99505 7.33835C8.77536 7.11866 8.4774 6.99524 8.16672 6.99524C7.85603 6.99524 7.55807 7.11866 7.33838 7.33835C7.1187 7.55803 6.99528 7.85599 6.99528 8.16668C6.99528 8.47736 7.1187 8.77533 7.33838 8.99501L12.3551 14L7.33838 19.005C7.22903 19.1135 7.14224 19.2425 7.08301 19.3847C7.02378 19.5268 6.99329 19.6793 6.99329 19.8333C6.99329 19.9874 7.02378 20.1398 7.08301 20.282C7.14224 20.4242 7.22903 20.5532 7.33838 20.6617C7.44684 20.771 7.57588 20.8578 7.71804 20.9171C7.86021 20.9763 8.0127 21.0068 8.16672 21.0068C8.32073 21.0068 8.47322 20.9763 8.61539 20.9171C8.75756 20.8578 8.88659 20.771 8.99505 20.6617L14.0001 15.645L19.0051 20.6617C19.1135 20.771 19.2425 20.8578 19.3847 20.9171C19.5269 20.9763 19.6794 21.0068 19.8334 21.0068C19.9874 21.0068 20.1399 20.9763 20.2821 20.9171C20.4242 20.8578 20.5533 20.771 20.6617 20.6617C20.7711 20.5532 20.8579 20.4242 20.9171 20.282C20.9763 20.1398 21.0068 19.9874 21.0068 19.8333C21.0068 19.6793 20.9763 19.5268 20.9171 19.3847C20.8579 19.2425 20.7711 19.1135 20.6617 19.005L15.6451 14Z" fill="#004600"/></svg></span>
                  </div>
                </div>
                {%- if section.settings.main_mobile_menu != blank or section.settings.main_button_link != blank or section.settings.main_redirect_link != blank or section.blocks.size > 0 -%}
                  <div class="LP_Header_latest_sides_innerleft_maindrawer_new">
                    <div class="LP_Header_latest_sides_innerleft_innerdrawer_new">
                      {%- if section.settings.main_mobile_menu != blank or section.settings.main_button_link != blank or section.settings.main_redirect_link != blank -%}
                        <div class="LP_Header_latest_sides_innerleft_innerdrawer_mainboths_new">
                          <div class="LP_Header_latest_sides_innerleft_innerdrawer_innerboths_new">
                            {%- if section.settings.main_mobile_menu != blank -%}
                              <div class="LP_Header_latest_sides_innerleft_innerdrawer_innerboths_mainmenus_new">
                                <div class="LP_Header_latest_sides_innerleft_innerdrawer_innerboths_innermenus_new">
                                  <ul>
                                    {%- for link in section.settings.main_mobile_menu.links -%}
                                      {%- comment %}<locksmith:ea39>{% endcomment -%}
                                        {%- capture var %}{% render 'locksmith-variables', scope: 'subject', subject: link, subject_parent: section.settings.main_mobile_menu, variable: 'transparent' %}{% endcapture %}{% if var == "true" %}{% else %}{% continue %}{% endif -%}
                                      {%- comment %}</locksmith:ea39>{% endcomment -%}
                                      <li>
                                        <a href="{{ link.url }}" target="_blank">
                                          {{ link.title }}<svg width="56" height="56" viewBox="0 0 56 56" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="28.09" cy="28.0025" r="20.91" transform="rotate(-180 28.09 28.0025)" fill="#FFE700"/><path d="M27.6501 39.9876L26.0751 38.3251L36.3126 28.0001L26.0751 17.6751L27.6501 16.0126L39.6376 28.0001L27.6501 39.9876Z" fill="#004600"/><path d="M37.9751 29.2251L16.9751 29.2251L16.9751 26.7751L37.9751 26.7751L37.9751 29.2251Z" fill="#004600"/></svg>
                                        </a>
                                      </li>
                                    {%- endfor -%}
                                  </ul>
                                </div>
                              </div>
                            {%- endif -%}
                            {%- if section.settings.main_button_text != blank and section.settings.main_button_link != blank -%}
                              <div class="LP_Header_latest_sides_innerleft_innerdrawer_innerboths_mainbutton_new">
                                <div class="LP_Header_latest_sides_innerleft_innerdrawer_innerboths_innerbutton_new">
                                  <a href="{{ section.settings.main_button_link }}" class="LP_Button_header_new" target="_blank">
                                    {{ section.settings.main_button_text }}
                                  </a>
                                </div>
                              </div>
                            {%- endif -%}
                            {%- if section.settings.main_redirect_text != blank and section.settings.main_redirect_link != blank -%}
                              <div class="LP_Header_latest_sides_innerleft_innerdrawer_innerboths_mainredirect_new">
                                <div class="LP_Header_latest_sides_innerleft_innerdrawer_innerboths_innerredirect_new">
                                  <a href="{{ section.settings.main_redirect_link }}" class="LP_Button_redirect_new" target="_blank">
                                    {{ section.settings.main_redirect_text }}
                                  </a>
                                </div>
                              </div>
                            {%- endif -%}
                          </div>
                        </div>
                      {%- endif -%}
                      {%- if section.blocks.size > 0 -%}
                        <div class="LP_Header_latest_sides_innerleft_innerdrawer_mainsocial_new">
                          <div class="LP_Header_latest_sides_innerleft_innerdrawer_innersocial_new">
                            {%- for block in section.blocks -%}
                              {%- if block.settings.main_social_icon != blank and block.settings.main_social_link != blank -%}
                                <div class="LP_Header_latest_sides_innerleft_innerdrawer_innersocial_mainicons_new">
                                  <div class="LP_Header_latest_sides_innerleft_innerdrawer_innersocial_innericons_new">
                                    <a href="{{ block.settings.main_social_link }}" target="_blank">
                                      {{
                                        block.settings.main_social_icon | 
                                        image_url: width: img.width | 
                                        image_tag: widths: '750, 900, 1080, 1296, 1512, 1728, 1944, 2048', 
                                        fetchpriority: 'high', 
                                        class:'Logo_image_new'
                                      }}
                                    </a>
                                  </div>
                                </div>
                              {%- endif -%}
                            {%- endfor -%}
                          </div>
                        </div>
                      {%- endif -%}
                    </div>
                  </div>
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}
          {%- if section.settings.main_custom_logo != blank -%}
            <div class="LP_Header_latest_sides_maincenter_new">
              <div class="LP_Header_latest_sides_innercenter_new">
                <a href="/" target="_blank">
                  {{
                    section.settings.main_custom_logo | 
                    image_url: width: img.width | 
                    image_tag: widths: '750, 900, 1080, 1296, 1512, 1728, 1944, 2048', 
                    fetchpriority: 'high', 
                    class:'Logo_image_new'
                  }}
                </a>
              </div>
            </div>
          {%- endif -%}
          {%- if section.settings.main_redirect_link != blank or section.settings.main_button_link != blank -%}
            <div class="LP_Header_latest_sides_mainright_new Desktop_only_new">
              <div class="LP_Header_latest_sides_innerright_new">
                {%- if section.settings.main_redirect_text != blank and section.settings.main_redirect_link != blank -%}
                  <div class="LP_Header_latest_sides_innerright_mainredirect_new">
                    <div class="LP_Header_latest_sides_innerright_innerredirect_new">
                      <a href="{{ section.settings.main_redirect_link }}" target="_blank">
                        {{ section.settings.main_redirect_text }}
                      </a>
                    </div>
                  </div>
                {%- endif -%}
                {%- if section.settings.main_button_text != blank and section.settings.main_button_link != blank -%}
                  <div class="LP_Header_latest_sides_innerright_mainbutton_new">
                    <div class="LP_Header_latest_sides_innerright_innerbutton_new">
                      <a href="{{ section.settings.main_button_link }}" class="LP_Button_header_new" target="_blank">
                        {{ section.settings.main_button_text }}
                      </a>
                    </div>
                  </div>
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}
          {%- if section.settings.main_redirect_link != blank -%}
            <div class="LP_Header_latest_sides_mainright_new Mobile_only_new">
              <div class="LP_Header_latest_sides_innerright_new">
                <a href="{{ section.settings.main_redirect_link }}" target="_blank">
                  <svg width="28" height="28" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M23.87 11.235C23.7062 9.53041 23.1038 7.89728 22.1214 6.49464C21.139 5.09199 19.8101 3.96765 18.2641 3.23109C16.7182 2.49453 15.0078 2.17085 13.2997 2.29159C11.5915 2.41232 9.94364 2.97334 8.51665 3.92001C7.29071 4.73977 6.26155 5.82086 5.50308 7.08564C4.74462 8.35041 4.27569 9.76747 4.12998 11.235C3.98705 12.6929 4.17044 14.1644 4.66685 15.5427C5.16326 16.9209 5.96025 18.1714 6.99998 19.2033L13.1833 25.3983C13.2918 25.5077 13.4208 25.5945 13.563 25.6537C13.7051 25.713 13.8576 25.7434 14.0116 25.7434C14.1657 25.7434 14.3182 25.713 14.4603 25.6537C14.6025 25.5945 14.7315 25.5077 14.84 25.3983L21 19.2033C22.0397 18.1714 22.8367 16.9209 23.3331 15.5427C23.8295 14.1644 24.0129 12.6929 23.87 11.235ZM19.3666 17.5583L14 22.925L8.63332 17.5583C7.84242 16.7674 7.23659 15.8111 6.85936 14.7581C6.48214 13.7051 6.3429 12.5816 6.45165 11.4683C6.5611 10.338 6.92037 9.24604 7.50348 8.2715C8.08659 7.29696 8.87897 6.46417 9.82332 5.83335C11.0611 5.01112 12.514 4.57253 14 4.57253C15.486 4.57253 16.9389 5.01112 18.1766 5.83335C19.1181 6.46173 19.9088 7.29084 20.4917 8.26111C21.0747 9.23138 21.4355 10.3187 21.5483 11.445C21.6606 12.562 21.5231 13.69 21.1458 14.7473C20.7685 15.8046 20.1608 16.7648 19.3666 17.5583ZM14 7.00001C12.9616 7.00001 11.9466 7.30792 11.0832 7.8848C10.2199 8.46168 9.54698 9.28161 9.14962 10.2409C8.75226 11.2002 8.64829 12.2558 8.85086 13.2742C9.05343 14.2926 9.55345 15.2281 10.2877 15.9623C11.0219 16.6966 11.9574 17.1966 12.9758 17.3991C13.9942 17.6017 15.0498 17.4977 16.0091 17.1004C16.9684 16.703 17.7883 16.0301 18.3652 15.1668C18.9421 14.3034 19.25 13.2884 19.25 12.25C19.2469 10.8586 18.6928 9.52501 17.7089 8.54111C16.725 7.55721 15.3914 7.0031 14 7.00001ZM14 15.1667C13.4231 15.1667 12.8592 14.9956 12.3796 14.6751C11.8999 14.3546 11.5261 13.8991 11.3053 13.3662C11.0846 12.8332 11.0268 12.2468 11.1394 11.681C11.2519 11.1152 11.5297 10.5955 11.9376 10.1876C12.3455 9.77972 12.8652 9.50193 13.431 9.38939C13.9967 9.27685 14.5832 9.33461 15.1161 9.55537C15.6491 9.77612 16.1046 10.15 16.4251 10.6296C16.7456 11.1092 16.9166 11.6732 16.9166 12.25C16.9166 13.0236 16.6094 13.7654 16.0624 14.3124C15.5154 14.8594 14.7735 15.1667 14 15.1667Z" fill="#004600"/></svg>
                </a>
              </div>
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
{%- endif -%}  

{% schema %}
  {
    "name": "LP Header Latest New",
    "class": "LP_Header_latest_new",
    "settings": [
      {
        "type": "color",
        "id": "main_background_color",
        "label": "Add Main Background Color",
        "default": "#FFE700"
      },
      {
        "type": "link_list",
        "id": "main_desktop_menu",
        "label": "Add Main Desktop Menu"
      },
      {
        "type": "link_list",
        "id": "main_mobile_menu",
        "label": "Add Main Mobile Menu"
      },
      {
        "type": "image_picker",
        "id": "main_custom_logo",
        "label": "Add Main Custom Logo"
      },
      {
        "type": "text",
        "id": "main_redirect_text",
        "label": "Add Main Redirect Text",
        "default": "Find In Store"
      },
      {
        "type": "url",
        "id": "main_redirect_link",
        "label": "Add Main Redirect Link",
        "default": "/"
      },
      {
        "type": "text",
        "id": "main_button_text",
        "label": "Add Main Button Text",
        "default": "Shop On Amazon"
      },
      {
        "type": "url",
        "id": "main_button_link",
        "label": "Add Main Button Link",
        "default": "/"
      }
    ],
    "blocks": [
      {
        "type": "social_link_list",
        "name": "Social Link List",
        "settings": [
          {
            "type": "image_picker",
            "id": "main_social_icon",
            "label": "Add Main Social Icon"
          }, 
          {
            "type": "url",
            "id": "main_social_link",
            "label": "Add Main Social Link"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "LP Header Latest New"
      }
    ]
  }
{% endschema %}