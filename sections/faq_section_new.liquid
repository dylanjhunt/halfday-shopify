{{ 'Faq_page_section_new.css' | asset_url | stylesheet_tag }}
{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.58 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.58 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}
<div id="faq_section_new" class="faq_page_section_wrapper_new section-{{ section.id }}-padding color-{{ section.settings.section_color_scheme }}">
  <div class="page-width">
    <div class="header-section">
      {% if section.settings.faq_main_title != blank %}
        <div class="Common_title_new"><h1>{{ section.settings.faq_main_title }}</h1></div>
      {% endif %}
      <div class="faq-contact large-up-hide medium-hide">{{ section.settings.left_panel_bottomcontent }}</div>
    </div>
    <div class="faq_page_section_main_container">
      <div class="faq_page_section_left_side">
        <div class="faq_page_section_left_side_panel">
          {% if section.settings.left_panel_title != blank %}
            <h2 class="faq-topics-title">{{ section.settings.left_panel_title }}</h2>
          {% endif %}
          <nav class="faq-topics" aria-label="FAQ topics">
            {% for category_index in (1..4) %}
              {% capture category_key %}faq_category_{{ category_index }}{% endcapture %}
              {% assign category_name = section.settings[category_key] %}
              {% if category_name != blank %}
                <a href="#faq_{{ category_name | downcase | replace: ' ', '_' }}">{{ category_name }}</a>
              {% endif %}
            {% endfor %}
          </nav>
          <div class="faq-contact small-hide">{{ section.settings.left_panel_bottomcontent }}</div>
        </div>
      </div>
      <div class="faq_page_section_right_side">
        {% for category_index in (1..4) %}
          {% capture category_key %}faq_category_{{ category_index }}{% endcapture %}
          {% assign category_name = section.settings[category_key] %}
          {% if category_name != blank %}
            <section class="halfday-faq-category" id="faq_{{ category_name | downcase | replace: ' ', '_' }}" aria-labelledby="faq-heading-{{ section.id }}-{{ category_index }}">
              <h2 id="faq-heading-{{ section.id }}-{{ category_index }}">{{ category_name }}</h2>
              {% assign first_question = true %}
              {% for block in section.blocks %}
                {% if block.type == 'information' and block.settings.title != blank and block.settings.infos != blank and block.settings.faq_category == category_name %}
                  <details class="halfday-faq-item" name="faq-{{ section.id }}-{{ category_index }}" {% if first_question %}open{% endif %} {{ block.shopify_attributes }}>
                    <summary><h3>{{ block.settings.title }}</h3><span aria-hidden="true" class="halfday-faq-icon"></span></summary>
                    <div class="halfday-faq-answer Common_infos_new">{{ block.settings.infos }}</div>
                  </details>
                  {% assign first_question = false %}
                {% endif %}
              {% endfor %}
            </section>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</div>

{% schema %}
  {
    "name": "FAQ",
    "settings": [
          {
      "type": "color_scheme",
      "id": "section_color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
      {
        "type": "text",
        "id": "faq_main_title",
        "label": "Faq Main Title"
      },
      {
        "type": "text",
        "id": "left_panel_title",
        "label": "Left Panel Title"
      },
      {
        "type": "richtext",
        "id": "left_panel_bottomcontent",
        "label": "Left Panel Bottom Content"
      },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    },
      {
            "type": "text",
            "id": "faq_category_1",
            "label": "Add FAQ Category 1",
            "info": "Add same as FAQ Title - which is on the left side",
            "default":"General"
          },
      {
            "type": "text",
            "id": "faq_category_2",
            "label": "Add FAQ Category 2",
            "info": "Add same as FAQ Title - which is on the left side",
            "default":"Products"
          },
      {
            "type": "text",
            "id": "faq_category_3",
            "label": "Add FAQ Category 3",
            "info": "Add same as FAQ Title - which is on the left side",
            "default":"Orders"
          },
      {
            "type": "text",
            "id": "faq_category_4",
            "label": "Add FAQ Category 4",
            "info": "Add same as FAQ Title - which is on the left side",
            "default":"Company"
          },
    ],
    "blocks": [
      {
        "type": "information",
        "name": "Information",
        "settings": [
          {
            "type": "text",
            "id": "faq_category",
            "label": "Add FAQ Category",
            "info": "Add same as FAQ Title - which is on the left side",
            "default":"Products"
          },
          {
            "type": "textarea",
            "id": "title",
            "label": "Add Main Question Text",
            "default": "Lorem Ipsum is simply dummy text?"
          },
          {
            "type": "richtext",
            "id": "infos",
            "label": "Add Main Answer Text",
            "default": "<p>Lorem Ipsum is simply dummy text of the printing and typesetting industry.</p>"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "FAQ"
      }
    ]
  }
{% endschema %}