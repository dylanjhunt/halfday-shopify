{%- if section.blocks.size > 0 -%}
  {%- liquid
    assign announcement_background = product.metafields.custom.product_announcement_back_color.value | default: section.settings.main_background_color
    assign announcement_text = product.metafields.custom.product_announcement_text_color.value | default: section.settings.main_information_color
    assign announcement_contrast = announcement_background | color_contrast: announcement_text
    if announcement_contrast < 4.5
      assign green_contrast = announcement_background | color_contrast: '#004600'
      assign white_contrast = announcement_background | color_contrast: '#ffffff'
      if green_contrast >= 4.5
        assign announcement_text = '#004600'
      elsif white_contrast >= 4.5
        assign announcement_text = '#ffffff'
      else
        assign announcement_text = '#000000'
      endif
    endif
  -%}
  <div class="Header_announcement_bar_main_new" style="background: {{ announcement_background }}; color: {{ announcement_text }};">
    <div class="page-width">
      <div class="Header_announcement_bar_inner_new">
        {%- if section.blocks.size > 0 -%}
          <div class="Header_announcement_bar_maindesktop_new Desktop_only_new">
            <div class="Header_announcement_bar_innerdesktop_new">
              <div class="swiper{% if section.blocks.size > 1 %} Header_announcement_bar_innerdesktop_slider{% endif %}">
                <div class="swiper-wrapper">
                  {%- for block in section.blocks -%}
                    {%- if block.settings.title != blank -%}
                      <div class="swiper-slide Header_announcement_bar_innerdesktop_mainboxs_new">
                        <div class="Header_announcement_bar_innerdesktop_innerboxs_new">
                          {{ block.settings.title }}
                        </div>
                      </div>  
                    {%- endif -%}
                  {%- endfor -%}
                </div>
              </div>
            </div>
          </div>
        {%- endif -%}
        {%- if section.blocks.size > 0 -%}
          <div class="Header_announcement_bar_mainmobile_new Mobile_only_new">
            <div class="Header_announcement_bar_innermobile_new">
              <div class="Header_announcement_bar_innermobile_marquee">
                <span>
                  {%- for block in section.blocks -%}
                    {%- if block.settings.title != blank -%}
                      <div class="Header_announcement_bar_innermobile_mainboxs_new">
                        <div class="Header_announcement_bar_innermobile_innerboxs_new">
                          {{ block.settings.title }}
                        </div>
                      </div>  
                    {%- endif -%}
                  {%- endfor -%}
                  {%- for block in section.blocks -%}
                    {%- if block.settings.title != blank -%}
                      <div class="Header_announcement_bar_innermobile_mainboxs_new">
                        <div class="Header_announcement_bar_innermobile_innerboxs_new">
                          {{ block.settings.title }}
                        </div>
                      </div>  
                    {%- endif -%}
                  {%- endfor -%}
                </span>
              </div>
            </div>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
  {
    "name": "Header Announcement Bar",
    "class": "Header_announcement_bar_new",
    "settings": [
      {
        "type": "color",
        "id": "main_background_color",
        "label": "Add Main Background Color",
        "default": "#FF5528"
      },
      {
        "type": "color",
        "id": "main_information_color",
        "label": "Add Main Information Color",
        "default": "#FFFFFF"
      }
    ],
    "blocks": [
      {
        "type": "information",
        "name": "Information",
        "settings": [
          {
            "type": "richtext",
            "id": "title",
            "label": "Add Main Information Text",
            "default": "<p>Lorem Ipsum is simply dummy text</p>"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Header Announcement Bar",
        "blocks": [
          {
            "type": "information"
          },
          {
            "type": "information"
          }
        ]
      }
    ]
  }
{% endschema %}
