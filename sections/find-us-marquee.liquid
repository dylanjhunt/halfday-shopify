{%- if section.blocks.size > 0 -%}
  <div class="find-us-marquee Index_information_marquee_main_new Index_store_logo_slider_main Index_information_marquee_main_new_{{ section.id }}" style="background: {% if product.metafields.custom.product_primary_color != blank %}{{ product.metafields.custom.product_primary_color }}{% else %}{{ section.settings.main_back_color }}{% endif %};">
   
    <div class="Index_information_marquee_inner_new"> 
      <div class="Index_information_marquee_loops_new">
        {%- if section.blocks.size > 0 -%}
          <div class="Index_store_logo_slider_mainmobile_new">
            <div class="Index_store_logo_slider_innermobile_new">
              <div class="swiper Index_store_logo_slider_innermobile_marquee">
                <div class="swiper-wrapper">
                  {%- for block in section.blocks -%}
                    {%- if block.settings.main_custom_image != blank -%}
                      <div class="swiper-slide Index_store_logo_slider_innermobile_mainboxs_new">
                        {%- if block.settings.main_custom_links != blank -%}
                          <a href="{{ block.settings.main_custom_links }}" target="_blank">
                        {%- endif -%}  
                            <div class="Index_store_logo_slider_innermobile_innerboxs_new">
                              {{
                                block.settings.main_custom_image | 
                                image_url: width: img.width | 
                                image_tag: widths: '750, 900, 1080, 1296, 1512, 1728, 1944, 2048', 
                                fetchpriority: 'high', 
                                class: 'Custom_image_new'
                              }}
                            </div>
                        {%- if block.settings.main_custom_links != blank -%}
                          </a>
                        {%- endif -%}
                      </div>  
                    {%- endif -%}
                  {%- endfor -%}
                  {%- for block in section.blocks -%}
                    {%- if block.settings.main_custom_image != blank -%}
                      <div class="swiper-slide Index_store_logo_slider_innermobile_mainboxs_new">
                        {%- if block.settings.main_custom_links != blank -%}
                          <a href="{{ block.settings.main_custom_links }}" target="_blank">
                        {%- endif -%}  
                            <div class="Index_store_logo_slider_innermobile_innerboxs_new">
                              {{
                                block.settings.main_custom_image | 
                                image_url: width: img.width | 
                                image_tag: widths: '750, 900, 1080, 1296, 1512, 1728, 1944, 2048', 
                                fetchpriority: 'high', 
                                class: 'Custom_image_new'
                              }}
                            </div>
                        {%- if block.settings.main_custom_links != blank -%}
                          </a>
                        {%- endif -%}
                      </div>  
                    {%- endif -%}
                  {%- endfor -%}
                </div>
              </div>
            </div>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
{%- endif -%}  

{% schema %}
  {
    "name": "Find Us Marquee",
    "class": "Index_information_marquee_new",
    "settings": [
      {
        "type": "color",
        "id": "main_back_color",
        "label": "Add Main Background Color",
        "default": "#FF5528"
      }
    ],
    "blocks": [
      {
        "type": "image",
        "name": "image",
        "settings": [
          {
            "type": "image_picker",
            "id": "main_custom_image",
            "label": "Add Main Custom Image"
          },
          {
            "type": "url",
            "id": "main_custom_links",
            "label": "Add Main Custom Links"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Find Us Marquee",
        "blocks": [
          {
            "type": "image"
          },
          {
            "type": "image"
          },
          {
            "type": "image"
          },
          {
            "type": "image"
          },
          {
            "type": "image"
          }
        ]
      }
    ]
  }
{% endschema %}