{%- if section.settings.main_common_video != blank or section.settings.main_desktop_image != blank or section.settings.main_mobile_image != blank or section.settings.main_heading_text != blank or section.settings.main_details_text != blank or section.settings.main_information_text != blank or section.settings.main_question_text != blank or section.settings.main_button_link != blank -%}
  <div class="LP_Hello_fresh_template_main_new" style="background: {{ section.settings.main_background_color }};">
    <div class="LP_Hello_fresh_template_inner_new">
      <div class="LP_Hello_fresh_template_sides_new">
        {%- if section.settings.main_common_video != blank or section.settings.main_desktop_image != blank or section.settings.main_mobile_image != blank -%}
          <div class="LP_Hello_fresh_template_sides_mainleft_new">
            <div class="LP_Hello_fresh_template_sides_innerleft_new">
              {%- if section.settings.main_common_video != blank -%}
                <div class="LP_Hello_fresh_template_sides_innerleft_videoimage_new">
                  {{ section.settings.main_common_video | video_tag: class:'Common_video_new', image_size: 'master', controls: false, autoplay: true, loop: true }}
                </div>
              {% else %}  
                {%- if section.settings.main_desktop_image != blank and section.settings.main_mobile_image != blank -%}
                  <div class="LP_Hello_fresh_template_sides_innerleft_videoimage_new">
                    {%- if section.settings.main_desktop_image != blank -%}
                      {{
                        section.settings.main_desktop_image | 
                        image_url: width: img.width | 
                        image_tag: widths: '750, 900, 1080, 1296, 1512, 1728, 1944, 2048', 
                        fetchpriority: 'high', 
                        class:'Desktop_image_new'
                      }}
                    {%- endif -%}
                    {%- if section.settings.main_mobile_image != blank -%}
                      {{
                        section.settings.main_mobile_image | 
                        image_url: width: img.width | 
                        image_tag: widths: '750, 900, 1080, 1296, 1512, 1728, 1944, 2048', 
                        fetchpriority: 'high', 
                        class:'Mobile_image_new'
                      }}
                    {%- endif -%}
                  </div>
                {%- endif -%}
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
        {%- if section.settings.main_heading_text != blank or section.settings.main_details_text != blank or section.settings.main_information_text != blank or section.settings.main_question_text != blank or section.settings.main_button_link != blank -%}
          <div class="LP_Hello_fresh_template_sides_mainright_new">
            <div class="LP_Hello_fresh_template_sides_innerright_new">
              <div class="LP_Hello_fresh_template_sides_innerright_top_new">
                {%- if section.settings.main_heading_text != blank -%}
                  <div class="LP_Hello_fresh_template_sides_innerright_maintitle_new">
                    <div class="LP_Hello_fresh_template_sides_innerright_innertitle_new">
                      <h2>{{ section.settings.main_heading_text }}</h2>
                    </div>
                  </div>
                {%- endif -%}
                {%- if section.settings.main_details_text != blank -%}
                  <div class="LP_Hello_fresh_template_sides_innerright_maininfos_new">
                    <div class="LP_Hello_fresh_template_sides_innerright_innerinfos_new">
                      {{ section.settings.main_details_text }}
                    </div>
                  </div>
                {%- endif -%}
                <div class="LP_Hello_fresh_template_sides_innerright_mainforms_new">
                  <div class="LP_Hello_fresh_template_sides_innerright_innerforms_new">
                    {{ section.settings.main_klaviyo_form }}
                  </div>
                </div>
                {%- if section.settings.main_information_text != blank -%}
                  <div class="LP_Hello_fresh_template_sides_innerright_maintexts_new">
                    <div class="LP_Hello_fresh_template_sides_innerright_innertexts_new">
                      {{ section.settings.main_information_text }}
                    </div>
                  </div>
                {%- endif -%}  
              </div>
              {%- if section.settings.main_question_text != blank or section.settings.main_button_link != blank -%}
                <div class="LP_Hello_fresh_template_sides_innerright_mainboths_new">
                  <div class="LP_Hello_fresh_template_sides_innerright_innerboths_new">
                    {%- if section.settings.main_question_text != blank -%}
                      <div class="LP_Hello_fresh_template_sides_innerright_innerboths_maintexts_new">
                        <div class="LP_Hello_fresh_template_sides_innerright_innerboths_innertexts_new">
                          {{ section.settings.main_question_text }}
                        </div>
                      </div>
                    {%- endif -%}
                    {%- if section.settings.main_button_text != blank and section.settings.main_button_link != blank -%}
                      <div class="LP_Hello_fresh_template_sides_innerright_innerboths_mainbutton_new">
                        <div class="LP_Hello_fresh_template_sides_innerright_innerboths_innerbutton_new">
                          <a href="{{ section.settings.main_button_link }}" class="LP_Button_latest_new" target="_blank">
                            {{ section.settings.main_button_text }}
                          </a>
                        </div>
                      </div>
                    {%- endif -%}
                  </div>
                </div>
              {%- endif -%}  
            </div>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
{%- endif -%}  

{% schema %}
  {
    "name": "LP Hello Fresh Template",
    "class": "LP_Hello_fresh_template_new",
    "settings": [
      {
        "type": "color",
        "id": "main_background_color",
        "label": "Add Main Background Color",
        "default": "#FF5528"
      },
      {
        "type": "video",
        "id": "main_common_video",
        "label": "Add Main Common Video"
      },
      {
        "type": "image_picker",
        "id": "main_desktop_image",
        "label": "Add Main Desktop Image"
      },
      {
        "type": "image_picker",
        "id": "main_mobile_image",
        "label": "Add Main Mobile Image"
      },
      {
        "type": "textarea",
        "id": "main_heading_text",
        "label": "Add Main Heading Text",
        "default": "Drink in the new look all year long."
      },
      {
        "type": "richtext",
        "id": "main_details_text",
        "label": "Add Main Details Text",
        "default": "<p>The only thing better than our new vibe? Entering to win a full year of free Halfdays.</p>"
      },
      {
        "type": "textarea",
        "id": "main_klaviyo_form",
        "label": "Klaviyo Form Code",
      },
      {
        "type": "richtext",
        "id": "main_information_text",
        "label": "Add Main Information Text",
        "default": "<p>NO PURCHASE NECESSARY. Offer ends 3/31/25 at 11:59pm ET. Limit one entry per person per household. Must be 18 years of older to enter. Offer limited to USA. Message and data rates may apply.</p>"
      },
      {
        "type": "textarea",
        "id": "main_question_text",
        "label": "Add Main Question Text",
        "default": "Need a Halfday right away?"
      },
      {
        "type": "text",
        "id": "main_button_text",
        "label": "Add Main Button Text",
        "default": "Find the local hookups"
      },
      {
        "type": "url",
        "id": "main_button_link",
        "label": "Add Main Button Link",
        "default": "/"
      }
    ],
    "presets": [
      {
        "name": "LP Hello Fresh Template"
      }
    ]
  }
{% endschema %}