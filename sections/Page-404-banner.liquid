{% if section.settings.bg_image != blank or section.settings.sub_heading_text != blank or section.settings.heading_text != blank or section.settings.information_text != blank or section.settings.button_text != blank or section.settings.button_link != blank %}
  <div class="Page_404_banner_main Page_404_banner_main_{{ section.id }}">
    {% if section.settings.bg_image != blank and section.settings.video_show == false %}
      <div class="Page_404_banner_bg_image small-hide">
        {{
          section.settings.bg_image | 
          image_url: width: img.width | 
          image_tag: widths: '750, 900, 1080, 1296, 1512, 1728, 1944, 2048', 
          fetchpriority: 'low'
        }}
      </div>
    {% endif %}
    {% if section.settings.video_show == true %}
     {% if section.settings.bg_video != blank %}
      <div class="Page_404_banner_bg_image small-hide">
        {{
            section.settings.bg_video
            | video_tag:
              image_size: '1100x',
              autoplay: true,
              loop: true,
              controls: false,
              muted: true
          }}
      </div>
    {% endif %}
    {% endif %}
    {% if section.settings.bg_image_mobile != blank and section.settings.video_show == false %}
      <div class="Page_404_banner_bg_image medium-hide large-up-hide">
        {{
          section.settings.bg_image_mobile | 
          image_url: width: img.width | 
          image_tag: widths: '750, 900, 1080, 1296, 1512, 1728, 1944, 2048', 
          fetchpriority: 'low'
        }}
      </div>
    {% endif %}
     {% if section.settings.video_show == true %}
    {% if section.settings.bg_video_mobile != blank %}
      <div class="Page_404_banner_bg_image medium-hide large-up-hide">
        {{
            section.settings.bg_video_mobile
            | video_tag:
              image_size: '1100x',
              autoplay: true,
              loop: true,
              controls: false,
              muted: true
          }}
      </div>
    {% endif %}
    {% endif %}
    <div class="page-width">
      <div class="Page_404_banner_inner">
        {% if section.settings.sub_heading_text != blank %}
          <div class="Page_404_banner_sub_heading_text">
            <p>
              {{ section.settings.sub_heading_text }}
            </p>
          </div>
        {% endif %}
        {% if section.settings.heading_text != blank %}
          <div class="Page_404_banner_heading_text Common_large_title_new">
            <h2>
              {{ section.settings.heading_text }}
            </h2>
          </div>
        {% endif %}
        {% if section.settings.information_text != blank %}
          <div class="Page_404_banner_information_text Common_infos_new">
            {{ section.settings.information_text }}
          </div>
        {% endif %}
        {% if section.settings.button_text != blank or section.settings.button_link != blank %}
          <div class="Page_404_banner_button_container">
            <a class="button" href="{{ section.settings.button_link }}">
              {{ section.settings.button_text }}
            </a>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
{% endif %}

<style>
  .Page_404_banner_main { padding: 175px 0; position: relative; }
  .Page_404_banner_bg_image { width: 100%; height: 100%; position: absolute; top: 0; left: 0; }
  .Page_404_banner_bg_image img, .Page_404_banner_bg_image video { width: 100%; height: 100% !important; display: block; object-fit: cover; }
  .Page_404_banner_inner { max-width: 520px; width: 100%; margin: 0 auto; position: relative; }
  .Page_404_banner_sub_heading_text p { font-family: var(--font-body-family); margin: 0; text-align: center; text-transform: uppercase; color: #FFF; font-size: 16px; font-weight: 900; line-height: 135%; letter-spacing: 0.32px; }
  .Page_404_banner_heading_text { padding-top: 28px; }
  .Page_404_banner_information_text, .Page_404_banner_button_container { padding-top: 32px; }
  .Page_404_banner_heading_text h2 { color: #FFE700; text-align: center; }
  .Page_404_banner_information_text p { color: #FFF; text-align: center; }
  .Page_404_banner_button_container { text-align: center; }
  .Page_404_banner_button_container a { background-color: #FFE700; color: #004600; }
  .Page_404_banner_button_container a:hover { color: #FFF; }

  @media (min-width: 1441px){
    .Page_404_banner_main { aspect-ratio: 1.98895; }
    .Page_404_banner_main .page-width { height: 100%; display: flex; align-items: center; }
  }

  @media (max-width: 989px){
    .Page_404_banner_main { padding: 90px 0; }
    .Page_404_banner_sub_heading_text { padding: 0 90px; }
    .Page_404_banner_heading_text h2 { font-size: 72px; letter-spacing: 2.88px; }
    .Page_404_banner_information_text, .Page_404_banner_button_container { padding-top: 24px; }
  }
</style>

{% schema %}
  {
    "name": "Page 404 Banner",
    "class": "Page_404_banner",
    "settings": [
      {
        "type": "checkbox",
        "id": "video_show",
        "label": "Video Show",
        "default":false
      },
      {
        "type": "video",
        "id": "bg_video",
        "label": "Video Desktop"
      },
      {
        "type": "video",
        "id": "bg_video_mobile",
        "label": "Video Mobile"
      },
      {
        "type": "image_picker",
        "id": "bg_image",
        "label": "Add Background Image"
      },
      {
        "type": "image_picker",
        "id": "bg_image_mobile",
        "label": "Add Background Image - Mobile"
      },
      {
        "type": "text",
        "id": "sub_heading_text",
        "label": "Add Subheading Text",
        "default": "404 – this page is out of office"
      },
      {
        "type": "textarea",
        "id": "heading_text",
        "label": "Add Heading Text",
        "default": "You’ve taken a wrong turn"
      },
      {
        "type": "richtext",
        "id": "information_text",
        "label": "Add Information Text",
        "default": "<p>This isn’t the escape you were looking for. Head back and find your next Halfday.</p>"
      },
      {
        "type": "text",
        "id": "button_text",
        "label": "Add Button Text",
        "default": "take me home"
      },
      {
        "type": "url",
        "id": "button_link",
        "label": "Add Button Link"
      }
    ],
    "presets": [
      {
        "name": "Page 404 Banner"
      }
    ]
  }
{% endschema %}