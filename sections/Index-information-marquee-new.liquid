{%- if section.blocks.size > 0 -%}
  <div class="Index_information_marquee_main_new Index_information_marquee_main_new_{{ section.id }}" style="background: {% if product.metafields.custom.product_primary_color != blank %}{{ product.metafields.custom.product_primary_color }}{% else %}{{ section.settings.main_back_color }}{% endif %}; color: {{ section.settings.main_text_color }};">
    <style>
      {%- if product.metafields.custom.product_overwrite_color != blank -%}
        .Index_information_marquee_main_new_{{ section.id }}
        { 
          color: {{ product.metafields.custom.product_overwrite_color }} !important;
        }
      {%- else -%}
        {%- if template == 'product' -%}
          .Index_information_marquee_main_new_{{ section.id }}
          { 
            color: #004600 !important;
          }
        {%- endif -%}  
      {%- endif -%}
    </style>
    <div class="Index_information_marquee_inner_new">
      <div class="Index_information_marquee_loops_new">
        <div class="Index_information_marquee">
          <span>
            {%- for block in section.blocks -%}
              {%- if block.settings.title != blank -%}
                <div class="Index_information_marquee_loops_mainboxs_new">
                  <div class="Index_information_marquee_loops_innerboxs_new">
                    <div class="Index_information_marquee_loops_innerboxs_infos_new">
                      {{ block.settings.title }}
                    </div>
                    <div class="Index_information_marquee_loops_innerboxs_icons_new">
                      <svg width="33" height="32" viewBox="0 0 33 32" fill="none" xmlns="http://www.w3.org/2000/svg"><g clip-path="url(#clip0_8038_6090)"><path d="M16.5069 0L18.8581 2.70632C20.0285 4.05161 21.8093 4.70063 23.5692 4.42073L27.11 3.85917L27.1713 7.44369C27.2027 9.22633 28.1492 10.8673 29.6781 11.7857L32.7518 13.6313L30.4951 16.4164C29.372 17.8019 29.0431 19.6685 29.6239 21.3549L30.7925 24.7452L27.2727 25.4293C25.5216 25.7686 24.0696 26.988 23.431 28.6517L22.147 32L19.0121 30.2611C17.4533 29.3969 15.557 29.3969 13.9983 30.2611L10.8634 32L9.5793 28.6517C8.94077 26.9862 7.48877 25.7686 5.73762 25.4293L2.21783 24.7452L3.38643 21.3549C3.96723 19.6685 3.63834 17.8019 2.51523 16.4164L0.260254 13.6331L3.33395 11.7874C4.86292 10.869 5.8111 9.22808 5.84084 7.44544L5.90206 3.86092L9.44285 4.42248C11.2045 4.70238 12.9854 4.05336 14.154 2.70807L16.5069 0Z" fill="{% if product.metafields.custom.product_secondary_color != blank %}{{ product.metafields.custom.product_secondary_color }}{% else %}{{ section.settings.main_icon_color }}{% endif %}"/></g><defs><clipPath id="clip0_8038_6090"><rect width="32.4933" height="32" fill="white" transform="translate(0.260254)"/></clipPath></defs></svg>
                    </div>
                  </div>
                </div>  
              {%- endif -%}
            {%- endfor -%}
            {%- for block in section.blocks -%}
              {%- if block.settings.title != blank -%}
                <div class="Index_information_marquee_loops_mainboxs_new">
                  <div class="Index_information_marquee_loops_innerboxs_new">
                    <div class="Index_information_marquee_loops_innerboxs_infos_new">
                      {{ block.settings.title }}
                    </div>
                    <div class="Index_information_marquee_loops_innerboxs_icons_new">
                      <svg width="33" height="32" viewBox="0 0 33 32" fill="none" xmlns="http://www.w3.org/2000/svg"><g clip-path="url(#clip0_8038_6090)"><path d="M16.5069 0L18.8581 2.70632C20.0285 4.05161 21.8093 4.70063 23.5692 4.42073L27.11 3.85917L27.1713 7.44369C27.2027 9.22633 28.1492 10.8673 29.6781 11.7857L32.7518 13.6313L30.4951 16.4164C29.372 17.8019 29.0431 19.6685 29.6239 21.3549L30.7925 24.7452L27.2727 25.4293C25.5216 25.7686 24.0696 26.988 23.431 28.6517L22.147 32L19.0121 30.2611C17.4533 29.3969 15.557 29.3969 13.9983 30.2611L10.8634 32L9.5793 28.6517C8.94077 26.9862 7.48877 25.7686 5.73762 25.4293L2.21783 24.7452L3.38643 21.3549C3.96723 19.6685 3.63834 17.8019 2.51523 16.4164L0.260254 13.6331L3.33395 11.7874C4.86292 10.869 5.8111 9.22808 5.84084 7.44544L5.90206 3.86092L9.44285 4.42248C11.2045 4.70238 12.9854 4.05336 14.154 2.70807L16.5069 0Z" fill="{% if product.metafields.custom.product_secondary_color != blank %}{{ product.metafields.custom.product_secondary_color }}{% else %}{{ section.settings.main_icon_color }}{% endif %}"/></g><defs><clipPath id="clip0_8038_6090"><rect width="32.4933" height="32" fill="white" transform="translate(0.260254)"/></clipPath></defs></svg>
                    </div>
                  </div>
                </div>  
              {%- endif -%}
            {%- endfor -%}
          </span>
        </div>
      </div>
    </div>
  </div>
{%- endif -%}  

{% schema %}
  {
    "name": "Index Information Marquee",
    "class": "Index_information_marquee_new",
    "settings": [
      {
        "type": "color",
        "id": "main_back_color",
        "label": "Add Main Background Color",
        "default": "#FF5528"
      },
      {
        "type": "color",
        "id": "main_text_color",
        "label": "Add Main Information Color",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "main_icon_color",
        "label": "Add Main Icon Image Color",
        "default": "#FFE700"
      }
    ],
    "blocks": [
      {
        "type": "information",
        "name": "Information",
        "settings": [
          {
            "type": "richtext",
            "id": "title",
            "label": "Add Main Information Text",
            "default": "<p>Lorem Ipsum is simply dummy text</p>"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Index Information Marquee",
        "blocks": [
          {
            "type": "information"
          },
          {
            "type": "information"
          },
          {
            "type": "information"
          },
          {
            "type": "information"
          },
          {
            "type": "information"
          }
        ]
      }
    ]
  }
{% endschema %}