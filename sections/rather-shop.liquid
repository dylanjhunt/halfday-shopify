{%- style -%}
  #section-{{ section.id }} {
    background-color:{{section.settings.bg_color}};
  }
{%- endstyle -%}

<div class="rather-shop" id="section-{{ section.id }}">
  <div class="page-width">
     {%- if section.settings.heading != blank -%}
       <h2 class="heading">
         {{ section.settings.heading }}
       </h2>
     {%- endif -%}

    
    {%- if section.blocks.size > 0 -%}
     <div class="swiper rather-shop-inner" js-rather-shop-slider>
        <div class="swiper-wrapper">
           {%- for block in section.blocks -%}
              <div class="block swiper-slide">
                <a target="_blank" href="{{ block.settings.link }}">
                 {{ block.settings.image }}
                </a>
              </div>
           {%- endfor -%}
        </div>
     </div>
    {%- endif -%}
    
  </div>
</div>

{% schema %}
  {
    "name": "Rather Shop",
    "settings": [
       {
         "type": "color",
         "id": "bg_color",
         "label": "Background color"
       },
       {
         "type": "textarea",
         "id": "heading",
         "label": "Heading"
       }
       
    ],
     "blocks": [
      {
        "type": "block",
        "name": "block",
        "settings": [
          {
            "type": "textarea",
            "id": "image",
            "label": "Image"
          },
          {
            "type": "url",
            "id": "link",
            "label": "Link"
          }
          
        ]
      }
    ],
    "presets": [
      {
        "name": "Rather Shop"
      }
    ]
  }
{% endschema %}