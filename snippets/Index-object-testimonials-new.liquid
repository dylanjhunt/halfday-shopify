{%- if index_testimonial_item_selection.main_custom_testimonial_list.value != blank -%}
  <div class="Index_object_testimonials_main_new" style="background: {{ section.settings.main_background_color }};">
    <div class="Index_object_testimonials_inner_new">
      {%- if index_testimonial_item_selection.main_custom_heading_text.value != blank or index_testimonial_item_selection.main_custom_details_text.value != blank -%}
        <div class="Index_object_testimonials_mainboths_new">
          <div class="page-width">
            <div class="Index_object_testimonials_innerboths_new">
              {%- if index_testimonial_item_selection.main_custom_heading_text.value != blank -%}
                <div class="Index_object_testimonials_innerboths_maintitle_new">
                  <div class="Common_large_title_new Index_object_testimonials_innerboths_innertitle_new">
                    <h2>{{ index_testimonial_item_selection.main_custom_heading_text.value }}</h2>
                  </div>
                </div>
              {%- endif -%}
              {%- if index_testimonial_item_selection.main_custom_details_text.value != blank -%}
                <div class="Index_object_testimonials_innerboths_maininfos_new">
                  <div class="Common_infos_new Index_object_testimonials_innerboths_innerinfos_new">
                    {{ index_testimonial_item_selection.main_custom_details_text | metafield_tag }}
                  </div>
                </div>
              {%- endif -%}
            </div>
          </div>
        </div>
      {%- endif -%}
      {%- if index_testimonial_item_selection.main_custom_testimonial_list.value != blank -%}
        <div class="Index_object_testimonials_mainloops_new">
          <div class="Index_object_testimonials_innerloops_new">
            <div class="swiper Index_object_testimonials_slider" dir="rtl">
              <div class="swiper-wrapper">
                {%- for main_custom_testimonial_list in index_testimonial_item_selection.main_custom_testimonial_list.value -%}
                  {%- if main_custom_testimonial_list.main_video_or_image_block.value != blank -%}
                    <div class="swiper-slide Index_object_testimonials_innerloops_maincolumn_new">
                      <div class="Index_object_testimonials_innerloops_innercolumn_new">
                        {%- if main_custom_testimonial_list.main_video_or_image_block.value contains "files" -%}
                          <div class="Index_object_testimonials_innerloops_innercolumn_imagevideo_new">
                            {{
                              main_custom_testimonial_list.main_video_or_image_block.value | 
                              image_url: width: 900 |
                              image_tag: widths: '280, 420, 600, 750, 900', sizes: '(min-width: 750px) 302px, 280px', loading: 'lazy',
                              fetchpriority: 'low', 
                              class: 'Static_image_new'
                            }}
                          </div>
                        {%- else -%}
                          <div class="Index_object_testimonials_innerloops_innercolumn_imagevideo_new">
                            {% render 'halfday-video', video: main_custom_testimonial_list.main_video_or_image_block.value, sizes: '(min-width: 750px) 302px, 280px' %}
                          </div>
                        {%- endif -%}
                      </div>
                    </div>
                  {%- endif -%}
                  {%- if main_custom_testimonial_list.main_custom_details_text.value != blank or main_custom_testimonial_list.main_custom_logo_image.value != blank or main_custom_testimonial_list.main_custom_author_text.value != blank -%}
                    <div class="swiper-slide Index_object_testimonials_innerloops_maindetail_new" dir="ltr" style="background: {{ main_custom_testimonial_list.main_custom_background_color.value }};">
                      <div class="Index_object_testimonials_innerloops_innerdetail_new">
                        {%- if main_custom_testimonial_list.main_custom_details_text.value != blank -%}
                          <div class="Index_object_testimonials_innerloops_innerdetail_maininfos_new">
                            <div class="Index_object_testimonials_innerloops_innerdetail_innerinfos_new">
                              {{ main_custom_testimonial_list.main_custom_details_text | metafield_tag }}
                            </div>
                          </div>
                        {%- endif -%}  
                        {%- if main_custom_testimonial_list.main_custom_logo_image.value != blank -%}
                          {%- if main_custom_testimonial_list.main_custom_logo_image.value contains "files" -%}
                            <div class="Index_object_testimonials_innerloops_innerdetail_mainimage_new">
                              <div class="Index_object_testimonials_innerloops_innerdetail_innerimage_new">
                                {{
                                  main_custom_testimonial_list.main_custom_logo_image.value | 
                                  image_url: width: 900 |
                                  image_tag: widths: '280, 420, 600, 750, 900', sizes: '(min-width: 750px) 302px, 280px', loading: 'lazy',
                                  fetchpriority: 'low', 
                                  class: 'Static_image_new'
                                }}
                              </div>
                            </div>
                          {%- endif -%}
                        {%- endif -%}  
                        {%- if main_custom_testimonial_list.main_custom_author_text.value != blank -%}
                          <div class="Index_object_testimonials_innerloops_innerdetail_mainboths_new">
                            <div class="Index_object_testimonials_innerloops_innerdetail_innerboths_new">
                              <div class="Index_object_testimonials_innerloops_innerdetail_innerboths_icons_new">
