                              </div>
                              <div class="Index_object_testimonials_innerloops_innerdetail_innerboths_title_new">
                                {{ main_custom_testimonial_list.main_custom_author_text.value }}
                              </div>
                            </div>
                          </div>
                        {%- endif -%}  
                      </div>
                    </div>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </div>
          </div>
        </div>
      {%- endif -%}  
    </div>
  </div>
{%- endif -%}   