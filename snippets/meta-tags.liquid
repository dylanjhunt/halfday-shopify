{%- capture fallback_description -%}{% render 'halfday-description-fallback', page_type: request.page_type, collection_handle: collection.handle, page_handle: page.handle, product_description: product.metafields.custom.product_short_description_text %}{%- endcapture -%}
{%- liquid
  assign og_title = page_title | default: shop.name
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = page_description | default: fallback_description | default: shop.description | default: shop.name

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif
%}

<meta property="og:site_name" content="{{ shop.name }}">
<meta property="og:url" content="{{ og_url }}">
{%- comment %}<locksmith:a6c7>{% endcomment -%}
  {%- capture var %}{% render 'locksmith-variables', variable: 'transparent', hiding_scope: 'resource' %}{% endcapture %}{% if var == 'true' %}<meta property="og:title" content="{{ og_title | escape }}">{% endif -%}
  {%- comment %}original: <meta property="og:title" content="{{ og_title | escape }}">{%- endcomment %}
{%- comment %}</locksmith:a6c7>{% endcomment -%}
{%- comment %}<locksmith:74a5>{% endcomment -%}
  {%- capture var %}{% render 'locksmith-variables', variable: 'transparent', hiding_scope: 'resource' %}{% endcapture %}{% if var == 'true' %}<meta property="og:type" content="{{ og_type }}">{% endif -%}
  {%- comment %}original: <meta property="og:type" content="{{ og_type }}">{%- endcomment %}
{%- comment %}</locksmith:74a5>{% endcomment -%}
{%- comment %}<locksmith:09a2>{% endcomment -%}
  {%- capture var %}{% render 'locksmith-variables', variable: 'transparent', hiding_scope: 'resource' %}{% endcapture %}{% if var == 'true' %}<meta property="og:description" content="{{ og_description | escape }}">{% endif -%}
  {%- comment %}original: <meta property="og:description" content="{{ og_description | escape }}">{%- endcomment %}
{%- comment %}</locksmith:09a2>{% endcomment -%}

{%- liquid
  assign og_image = page_image
  if request.page_type == 'product' and product.metafields.custom.product_custom_og_image != blank
    assign og_image = product.metafields.custom.product_custom_og_image.value.preview_image | default: product.metafields.custom.product_custom_og_image.value
  endif
-%}
{%- if og_image != blank -%}
  {%- capture image_is_public -%}{% render 'locksmith-variables', variable: 'transparent', hiding_scope: 'resource' %}{%- endcapture -%}
  {%- if image_is_public == 'true' -%}
    <meta property="og:image" content="https:{{ og_image | image_url | escape }}">
    <meta property="og:image:secure_url" content="https:{{ og_image | image_url | escape }}">
    <meta property="og:image:width" content="{{ og_image.width }}">
    <meta property="og:image:height" content="{{ og_image.height }}">
    {%- if og_image.alt != blank -%}
      <meta property="og:image:alt" content="{{ og_image.alt | escape }}">
    {%- endif -%}
  {%- endif -%}
{%- endif -%}

{%- comment -%}Current product pages direct shoppers to retailers. Shopify prices do not describe those offers.{%- endcomment -%}

{%- if settings.social_twitter_link != blank -%}
  <meta name="twitter:site" content="{{ settings.social_twitter_link | split: 'twitter.com/' | last | prepend: '@' }}">
{%- endif -%}
<meta name="twitter:card" content="summary_large_image">
{%- comment %}<locksmith:92da>{% endcomment -%}
  {%- capture var %}{% render 'locksmith-variables', variable: 'transparent', hiding_scope: 'resource' %}{% endcapture %}{% if var == 'true' %}<meta name="twitter:title" content="{{ og_title | escape }}">{% endif -%}
  {%- comment %}original: <meta name="twitter:title" content="{{ og_title | escape }}">{%- endcomment %}
{%- comment %}</locksmith:92da>{% endcomment -%}
{%- comment %}<locksmith:9e95>{% endcomment -%}
  {%- capture var %}{% render 'locksmith-variables', variable: 'transparent', hiding_scope: 'resource' %}{% endcapture %}{% if var == 'true' %}<meta name="twitter:description" content="{{ og_description | escape }}">{% endif -%}
  {%- comment %}original: <meta name="twitter:description" content="{{ og_description | escape }}">{%- endcomment %}
{%- comment %}</locksmith:9e95>{% endcomment -%}
